<UserControl
    x:Class="Sentinel.UI.Views.DoorsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:views="clr-namespace:Sentinel.UI.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  DataContext: DoorsViewModel  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ===== Discovery toolbar =====  -->
        <Border Style="{StaticResource Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="210" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource LabelText}" Text="Linked model" />
                <ComboBox
                    Grid.Column="1"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding Links}"
                    SelectedItem="{Binding SelectedLink}"
                    Style="{StaticResource InputComboBox}"
                    ToolTip="Architectural model (IFC or Revit link) that contains the doors." />

                <TextBlock
                    Grid.Column="2"
                    Margin="14,0,8,0"
                    Style="{StaticResource LabelText}"
                    Text="Scope" />
                <ComboBox
                    Grid.Column="3"
                    DisplayMemberPath="Text"
                    ItemsSource="{Binding Scopes}"
                    SelectedItem="{Binding SelectedScope}"
                    Style="{StaticResource InputComboBox}" />

                <StackPanel
                    Grid.Column="4"
                    Margin="8,0,0,0"
                    Orientation="Horizontal">
                    <!--  Level picker (only for the 'Selected levels' scope)  -->
                    <Grid Visibility="{Binding IsLevelScope, Converter={StaticResource BoolToVis}}">
                        <ToggleButton
                            x:Name="LevelToggle"
                            Height="26"
                            MinWidth="130"
                            Margin="0,0,6,0"
                            Content="{Binding LevelSummary}"
                            Style="{StaticResource FilterChip}" />
                        <Popup
                            AllowsTransparency="True"
                            IsOpen="{Binding IsChecked, ElementName=LevelToggle}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=LevelToggle}"
                            StaysOpen="False">
                            <Border
                                MinWidth="200"
                                MaxHeight="320"
                                Padding="8"
                                Background="{DynamicResource SecondaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Levels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    Margin="0,3"
                                                    Content="{Binding Name}"
                                                    IsChecked="{Binding IsChecked}"
                                                    Style="{StaticResource InputCheckBox}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button
                        Command="{Binding FindDoorsCommand}"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Collect the doors of the linked model (read-only).">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="DoorOpen" />
                            <TextBlock Text="Find Doors" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButton}"
                        ToolTip="Check all door sets: source doors, missing or manually moved components.">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="Refresh" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ===== Search + filter chips =====  -->
        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox
                    x:Name="SearchBox"
                    Padding="24,0,4,0"
                    Style="{StaticResource InputTextBox}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <materialDesign:PackIcon
                    Width="14"
                    Height="14"
                    Margin="7,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource IconForegroundBrush}"
                    IsHitTestVisible="False"
                    Kind="Magnify" />
                <TextBlock
                    Margin="26,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource IconForegroundBrush}"
                    IsHitTestVisible="False"
                    Text="Search door, room, level, set, status…"
                    Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
            </Grid>
            <StackPanel
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <RadioButton
                    Command="{Binding FilterCommand}"
                    CommandParameter="All"
                    Content="All"
                    GroupName="DoorFilter"
                    IsChecked="True"
                    Style="{StaticResource FilterChip}" />
                <RadioButton
                    Command="{Binding FilterCommand}"
                    CommandParameter="Unassigned"
                    Content="Unassigned"
                    GroupName="DoorFilter"
                    Style="{StaticResource FilterChip}" />
                <RadioButton
                    Command="{Binding FilterCommand}"
                    CommandParameter="Ready"
                    Content="Ready"
                    GroupName="DoorFilter"
                    Style="{StaticResource FilterChip}" />
                <RadioButton
                    Command="{Binding FilterCommand}"
                    CommandParameter="Placed"
                    Content="Placed"
                    GroupName="DoorFilter"
                    Style="{StaticResource FilterChip}" />
                <RadioButton
                    Command="{Binding FilterCommand}"
                    CommandParameter="Attention"
                    Content="Needs attention"
                    GroupName="DoorFilter"
                    Style="{StaticResource FilterChip}" />
                <RadioButton
                    Command="{Binding FilterCommand}"
                    CommandParameter="Ignored"
                    Content="Ignored"
                    GroupName="DoorFilter"
                    Style="{StaticResource FilterChip}" />
            </StackPanel>
        </Grid>

        <!--  ===== Grid + right panel =====  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition
                    x:Name="RightColumn"
                    Width="390"
                    MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Padding="4" Style="{StaticResource Panel}">
                <Grid>
                    <DataGrid
                        x:Name="DoorGrid"
                        IsSynchronizedWithCurrentItem="False"
                        ItemsSource="{Binding RowsView}"
                        MouseDoubleClick="DoorGrid_MouseDoubleClick"
                        SelectionChanged="DoorGrid_SelectionChanged"
                        SelectionMode="Extended"
                        Style="{StaticResource SentinelGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Width="148"
                                Header="Status"
                                SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Reason}">
                                            <Ellipse Style="{StaticResource StatusDot}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding StatusText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn
                                Width="130"
                                Header="Door"
                                SortMemberPath="Mark">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Mark}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{DynamicResource IconForegroundBrush}"
                                                Text="{Binding TypeName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Level}"
                                Header="Level" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="140"
                                Binding="{Binding Rooms}"
                                Header="Side A | Side B" />
                            <DataGridTemplateColumn
                                Width="64"
                                Header="Set"
                                SortMemberPath="SetCode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding SetCode}"
                                            ToolTip="{Binding SetName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding AccessText}"
                                Header="Access" />
                            <DataGridTextColumn
                                Width="46"
                                Binding="{Binding ComponentsText}"
                                Header="Parts" />
                            <DataGridTextColumn
                                Width="94"
                                Binding="{Binding ReviewText}"
                                Header="Review" />
                            <DataGridTemplateColumn
                                Width="1.3*"
                                MinWidth="120"
                                Header="Reason">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Foreground="{DynamicResource IconForegroundBrush}"
                                            Text="{Binding Reason}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Reason}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!--  Empty state  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}">
                        <materialDesign:PackIcon
                            Width="42"
                            Height="42"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource IconForegroundBrush}"
                            Kind="DoorClosedLock" />
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyText}"
                            Text="No doors yet." />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource CaptionText}"
                            Text="Choose the linked architectural model and press Find Doors." />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext" />

            <!--  Right panel: preview (when active) + inspector  -->
            <Border
                Grid.Column="2"
                Padding="0"
                Style="{StaticResource Panel}">
                <ScrollViewer
                    x:Name="RightScroll"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,10,12,12">
                        <views:PreviewPanel DataContext="{Binding Preview}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                        <views:InspectorPanel DataContext="{Binding Inspector}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  ===== Bulk action bar =====  -->
        <Border
            Grid.Row="3"
            Margin="0,8,0,0"
            Style="{StaticResource Panel}">
            <DockPanel LastChildFill="False">
                <StackPanel
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <TextBlock Style="{StaticResource LabelText}" Text="Door set" />
                    <ComboBox
                        Width="220"
                        Margin="0,0,6,0"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding Definitions}"
                        SelectedItem="{Binding AssignDefinition}"
                        Style="{StaticResource InputComboBox}" />
                    <Button
                        Command="{Binding AssignCommand}"
                        Content="Assign"
                        Style="{StaticResource ActionButton}"
                        ToolTip="Assign the chosen door set type to the selected doors." />
                    <Button
                        Command="{Binding UnassignCommand}"
                        Content="Remove set"
                        Style="{StaticResource ActionButton}" />
                    <Button
                        Command="{Binding SuggestCommand}"
                        Content="Suggest from rules…"
                        Style="{StaticResource ActionButton}"
                        ToolTip="Suggest door set types for unassigned doors from the assignment rules (confirmation required)." />
                    <Rectangle
                        Width="1"
                        Height="22"
                        Margin="6,0,12,0"
                        Fill="{DynamicResource BorderBrush}" />
                    <Button
                        Command="{Binding PreviewCommand}"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Review the selected doors one by one with preview graphics, then confirm each.">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="EyeOutline" />
                            <TextBlock Text="Preview…" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding PlaceCommand}"
                        Content="Place automatically"
                        Style="{StaticResource ActionButton}"
                        ToolTip="Place all selected, not yet placed sets. Results stay reviewable." />
                    <Button
                        Command="{Binding UpdateCommand}"
                        Content="Update placement"
                        Style="{StaticResource ActionButton}"
                        ToolTip="Apply configuration changes to already placed sets (manual moves are kept)." />
                    <Rectangle
                        Width="1"
                        Height="22"
                        Margin="6,0,12,0"
                        Fill="{DynamicResource BorderBrush}" />
                    <Button
                        Command="{Binding IgnoreCommand}"
                        Content="Ignore"
                        Style="{StaticResource ActionButton}" />
                    <Button
                        Command="{Binding UnignoreCommand}"
                        Content="Unignore"
                        Style="{StaticResource ActionButton}" />
                </StackPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Style="{StaticResource CaptionText}"
                    Text="{Binding SelectedCount, StringFormat={}{0} selected}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
