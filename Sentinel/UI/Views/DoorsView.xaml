<UserControl
    x:Class="Sentinel.UI.Views.DoorsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="clr-namespace:Sentinel.UI"
    xmlns:views="clr-namespace:Sentinel.UI.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SharedDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="BarSeparator" TargetType="{x:Type Rectangle}">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="10,0" />
                <Setter Property="Fill" Value="{DynamicResource Separator}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ButtonIconLabel" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="15" />
                <Setter Property="Height" Value="15" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ===== Discovery toolbar (floating material: the only translucent layer on this page) =====  -->
        <Border
            Padding="10,8"
            Background="{DynamicResource Toolbar.Material}"
            BorderBrush="{DynamicResource Floating.Edge}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Floating}">
            <DockPanel>
                <!--  Search (Ctrl+F)  -->
                <Grid
                    Width="220"
                    Margin="12,0,0,0"
                    DockPanel.Dock="Right">
                    <TextBox
                        x:Name="SearchBox"
                        Padding="30,0,28,0"
                        AutomationProperties.Name="Search doors"
                        Style="{StaticResource Input.Text}"
                        Tag="Search mark, room, set, GUID"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                        ToolTip="Search doors (Ctrl+F)" />
                    <materialDesign:PackIcon
                        Width="15"
                        Height="15"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Text.Tertiary}"
                        IsHitTestVisible="False"
                        Kind="Magnify" />
                    <Button
                        Width="24"
                        Height="24"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Clear search"
                        Click="ClearSearch_Click"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Clear search"
                        Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NotEmptyToVis}}">
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            Kind="CloseCircle" />
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        x:Name="LinkLabel"
                        Style="{StaticResource Type.Label}"
                        Text="Linked model" />
                    <ComboBox
                        x:Name="LinkCombo"
                        Width="200"
                        AutomationProperties.Name="Linked model"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding Links}"
                        SelectedItem="{Binding SelectedLink}"
                        Style="{StaticResource Input.Combo}"
                        ToolTip="Architectural model (IFC or Revit link) that contains the doors" />
                    <TextBlock
                        x:Name="ScopeLabel"
                        Margin="16,0,12,0"
                        Style="{StaticResource Type.Label}"
                        Text="Scope" />
                    <ComboBox
                        x:Name="ScopeCombo"
                        Width="150"
                        AutomationProperties.Name="Discovery scope"
                        DisplayMemberPath="Text"
                        ItemsSource="{Binding Scopes}"
                        SelectedItem="{Binding SelectedScope}"
                        Style="{StaticResource Input.Combo}"
                        ToolTip="Which doors of the linked model to collect" />

                    <!--  Level picker (only for the 'Selected levels' scope)  -->
                    <Grid Margin="8,0,0,0" Visibility="{Binding IsLevelScope, Converter={StaticResource BoolToVis}}">
                        <ToggleButton
                            x:Name="LevelToggle"
                            MinWidth="120"
                            AutomationProperties.Name="Levels"
                            Style="{StaticResource Button.Secondary}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LevelSummary}" />
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Kind="ChevronDown" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup
                            AllowsTransparency="True"
                            IsOpen="{Binding IsChecked, ElementName=LevelToggle}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=LevelToggle}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                MinWidth="200"
                                MaxHeight="320"
                                Margin="0,4,12,12"
                                Padding="10"
                                Style="{StaticResource PopupSurface}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Levels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    Margin="0,3"
                                                    Content="{Binding Name}"
                                                    IsChecked="{Binding IsChecked}"
                                                    Style="{StaticResource Input.Check}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button
                        Margin="12,0,0,0"
                        Command="{Binding FindDoorsCommand}"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Collect the doors of the linked model (reads the link, changes nothing)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DoorOpen" Style="{StaticResource ButtonIconLabel}" />
                            <TextBlock Text="Find doors" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="32"
                        Height="32"
                        Margin="4,0,0,0"
                        AutomationProperties.Name="Refresh status"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Refresh status: check source doors and placed components (F5)">
                        <materialDesign:PackIcon
                            Width="17"
                            Height="17"
                            Kind="Refresh" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  ===== Status filter (segmented, with counts) + workspace toggle =====  -->
        <DockPanel Grid.Row="1" Margin="0,12,0,10">
            <ToggleButton
                Height="30"
                Margin="12,0,0,0"
                Padding="10,0"
                AutomationProperties.Name="Show review panel"
                DockPanel.Dock="Right"
                IsChecked="{Binding IsInspectorVisible}"
                Style="{StaticResource Button.Plain}"
                ToolTip="Show or hide the review panel">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DockRight" Style="{StaticResource ButtonIconLabel}" />
                    <TextBlock x:Name="ToggleWorkspaceText" Text="Review panel" />
                </StackPanel>
            </ToggleButton>
            <Border
                HorizontalAlignment="Left"
                AutomationProperties.Name="Status filter"
                Style="{StaticResource Segmented}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="All"
                        GroupName="DoorFilter"
                        IsChecked="True"
                        Style="{StaticResource Segment}">
                        <TextBlock>
                            <Run Text="All" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountAll, StringFormat={}  {0}, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="Unassigned"
                        GroupName="DoorFilter"
                        Style="{StaticResource Segment}"
                        ToolTip="Doors without a door set">
                        <TextBlock>
                            <Run Text="Unassigned" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountUnassigned, StringFormat={}  {0}, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="Ready"
                        GroupName="DoorFilter"
                        Style="{StaticResource Segment}"
                        ToolTip="Assigned, not placed yet">
                        <TextBlock>
                            <Run Text="To place" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountReady, StringFormat={}  {0}, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="Placed"
                        GroupName="DoorFilter"
                        Style="{StaticResource Segment}">
                        <TextBlock>
                            <Run Text="Placed" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountPlaced, StringFormat={}  {0}, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="Attention"
                        GroupName="DoorFilter"
                        Style="{StaticResource Segment}"
                        ToolTip="Modified, missing components, changed source doors, errors or needing review">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="13"
                                Height="13"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Status.Warning}"
                                Kind="AlertOutline" />
                            <TextBlock>
                                <Run Text="Attention" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountAttention, StringFormat={}  {0}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="Ignored"
                        GroupName="DoorFilter"
                        Style="{StaticResource Segment}">
                        <TextBlock>
                            <Run Text="Ignored" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountIgnored, StringFormat={}  {0}, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                </StackPanel>
            </Border>
        </DockPanel>

        <!--  ===== Grid + review workspace =====  -->
        <Grid x:Name="MainArea" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition x:Name="SplitterColumn" Width="12" />
                <ColumnDefinition
                    x:Name="WorkspaceColumn"
                    Width="380"
                    MinWidth="300"
                    MaxWidth="560" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Surface}">
                <Grid>
                    <DataGrid
                        x:Name="DoorGrid"
                        AutomationProperties.Name="Doors"
                        IsSynchronizedWithCurrentItem="False"
                        ItemsSource="{Binding RowsView}"
                        MouseDoubleClick="DoorGrid_MouseDoubleClick"
                        SelectionChanged="DoorGrid_SelectionChanged"
                        SelectionMode="Extended"
                        SizeChanged="DoorGrid_SizeChanged"
                        Style="{StaticResource SentinelGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                x:Name="StatusColumn"
                                Width="160"
                                MinWidth="160"
                                Header="Status"
                                SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding StatusText}">
                                            <materialDesign:PackIcon Style="{StaticResource StatusIcon}" />
                                            <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn
                                Width="1.1*"
                                MinWidth="90"
                                Header="Door"
                                SortMemberPath="Mark">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding TypeName}">
                                            <Run FontWeight="SemiBold" Text="{Binding Mark, Mode=OneWay}" />
                                            <Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding TypeName, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn
                                Width="1.4*"
                                MinWidth="100"
                                Header="Access"
                                SortMemberPath="AccessOrRooms">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding AccessOrRooms}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding AccessOrRooms}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn
                                x:Name="SetColumn"
                                Width="76"
                                MinWidth="76"
                                Header="Set"
                                SortMemberPath="SetCode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding SetCode}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding SetName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn
                                Width="1.6*"
                                MinWidth="90"
                                Header="Reason"
                                SortMemberPath="Reason">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Foreground="{DynamicResource Text.Secondary}"
                                            Text="{Binding Reason}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Reason}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                x:Name="LevelColumn"
                                Width="90"
                                MinWidth="90"
                                Binding="{Binding Level}"
                                Header="Level" />
                            <DataGridTextColumn
                                x:Name="PartsColumn"
                                Width="60"
                                MinWidth="60"
                                Binding="{Binding ComponentsText}"
                                Header="Parts" />
                            <DataGridTextColumn
                                x:Name="ReviewColumn"
                                Width="96"
                                MinWidth="96"
                                Binding="{Binding ReviewText}"
                                Header="Review" />
                        </DataGrid.Columns>
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
                        </DataGrid.InputBindings>
                    </DataGrid>

                    <!--  Empty state  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}">
                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource Text.Tertiary}"
                            Kind="DoorClosedLock" />
                        <TextBlock
                            Margin="0,12,0,4"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Type.Section}"
                            Text="No doors yet" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource Type.Secondary}"
                            Text="Choose the linked architectural model, then select Find doors." />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter
                x:Name="WorkspaceSplitter"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Resize review panel"
                DragCompleted="WorkspaceSplitter_DragCompleted"
                ResizeBehavior="PreviousAndNext" />

            <views:DoorWorkspace
                x:Name="Workspace"
                Grid.Column="2"
                ui:Motion.FromY="0"
                ui:Motion.Reveal="True" />
        </Grid>

        <!--  ===== Selection action bar (floating; hidden while a preview runs – the review panel drives it) =====  -->
        <Border
            x:Name="ActionBar"
            Grid.Row="3"
            Margin="0,10,0,2"
            Padding="12,8"
            AutomationProperties.Name="Actions for the selected doors"
            Style="{StaticResource Floating}"
            Visibility="{Binding Preview.IsActive, Converter={StaticResource InverseBoolToVis}}">
            <DockPanel>
                <!--  Scope of every command on this bar  -->
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Accent.Text}"
                        Kind="CheckboxMultipleMarkedOutline"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        x:Name="SelectionLabel"
                        MaxWidth="220"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding SelectionText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding SelectionText}" />
                    <Button
                        Margin="4,0,0,0"
                        Command="{Binding ClearSelectionCommand}"
                        Content="Clear"
                        Style="{StaticResource Button.Plain}"
                        ToolTip="Clear the selection (Esc in the list)"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!--  Overflow: infrequent commands  -->
                <Button
                    x:Name="MoreButton"
                    Width="32"
                    Height="32"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="More actions"
                    Click="MoreButton_Click"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="More actions for the selected doors">
                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Kind="DotsHorizontal" />
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreMenu">
                            <MenuItem Command="{Binding PlaceCommand}" Header="Place without review…" x:Name="PlaceMenuItem">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="PlaylistCheck" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding SuggestCommand}" Header="Suggest sets from rules…">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="AutoFix" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource MenuSeparator}" />
                            <MenuItem Command="{Binding UnassignCommand}" Header="Remove door set…">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="LinkVariantRemove" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding IgnoreCommand}" Header="Ignore doors">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="EyeOffOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding UnignoreCommand}" Header="Stop ignoring" />
                            <Separator Style="{StaticResource MenuSeparator}" />
                            <MenuItem Command="{Binding ZoomCommand}" Header="Zoom to door">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="MagnifyScan" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding SelectComponentsCommand}" Header="Select components in Revit" />
                            <MenuItem Command="{Binding SelectSourceDoorCommand}" Header="Select source door in Revit" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!--  Assign | Review and place  -->
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ComboBox
                        x:Name="AssignCombo"
                        Width="170"
                        AutomationProperties.Name="Door set to assign"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding Definitions}"
                        SelectedItem="{Binding AssignDefinition}"
                        Style="{StaticResource Input.Combo}"
                        ToolTip="Door set to assign to the selected doors" />
                    <Button
                        Margin="6,0,0,0"
                        ui:Emphasis.IsPrimary="{Binding IsAssignPrimary}"
                        Command="{Binding AssignCommand}"
                        Content="Assign"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Assign this door set to the selected doors (placed sets ask before changing)" />
                    <Rectangle Style="{StaticResource BarSeparator}" />
                    <Button
                        ui:Emphasis.IsPrimary="{Binding IsReviewPrimary}"
                        Command="{Binding PreviewCommand}"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Walk through the selected doors with a preview in Revit, then place each one">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="EyeOutline" Style="{StaticResource ButtonIconLabel}" />
                            <TextBlock Text="Review and place" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PlaceButton"
                        Margin="6,0,0,0"
                        Command="{Binding PlaceCommand}"
                        Content="Place without review"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Place all selected sets at once (asks for confirmation first)" />
                    <Button
                        Margin="6,0,0,0"
                        ui:Emphasis.IsPrimary="{Binding IsUpdatePrimary}"
                        Command="{Binding UpdateCommand}"
                        Content="Update placement"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Move, add or delete placed components so they match the current set and door" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
