<UserControl
    x:Class="Sentinel.UI.Views.DoorsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="clr-namespace:Sentinel.UI"
    xmlns:views="clr-namespace:Sentinel.UI.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SharedDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="BarSeparator" TargetType="{x:Type Rectangle}">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="10,0" />
                <Setter Property="Fill" Value="{DynamicResource Separator}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ===== Status filter (segmented, with counts) · refresh · search · review panel toggle =====  -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button
                    Width="32"
                    Height="32"
                    Margin="12,0,6,0"
                    AutomationProperties.Name="Refresh status"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Refresh status: check source doors and placed components (F5)">
                    <materialDesign:PackIcon
                        Width="17"
                        Height="17"
                        Kind="Refresh" />
                </Button>
                <Grid x:Name="SearchHost" Width="220">
                    <TextBox
                        x:Name="SearchBox"
                        Padding="30,0,28,0"
                        AutomationProperties.Name="Search doors"
                        Style="{StaticResource Input.Text}"
                        Tag="Search"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                        ToolTip="Search by mark, room, set, type or IFC GUID (Ctrl+F)" />
                    <materialDesign:PackIcon
                        Width="15"
                        Height="15"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Text.Tertiary}"
                        IsHitTestVisible="False"
                        Kind="Magnify" />
                    <Button
                        Width="24"
                        Height="24"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Clear search"
                        Click="ClearSearch_Click"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Clear search"
                        Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NotEmptyToVis}}">
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            Kind="CloseCircle" />
                    </Button>
                </Grid>
                <ToggleButton
                    Width="32"
                    Height="32"
                    Margin="6,0,0,0"
                    AutomationProperties.Name="Show review panel"
                    IsChecked="{Binding IsInspectorVisible}"
                    ToolTip="Show or hide the review panel">
                    <ToggleButton.Style>
                        <Style BasedOn="{StaticResource Button.Icon}" TargetType="{x:Type ToggleButton}">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Kind="DockRight" />
                </ToggleButton>
            </StackPanel>
            <Border
                HorizontalAlignment="Left"
                AutomationProperties.Name="Status filter"
                Style="{StaticResource Segmented}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="All"
                        GroupName="DoorFilter"
                        IsChecked="True"
                        Style="{StaticResource Segment}">
                        <TextBlock>
                            <Run Text="All" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountAll, StringFormat={}  {0}, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="Unassigned"
                        GroupName="DoorFilter"
                        Style="{StaticResource Segment}"
                        ToolTip="Doors without a door set">
                        <TextBlock>
                            <Run Text="Unassigned" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountUnassigned, StringFormat={}  {0}, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="Ready"
                        GroupName="DoorFilter"
                        Style="{StaticResource Segment}"
                        ToolTip="Assigned, not placed yet">
                        <TextBlock>
                            <Run Text="To place" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountReady, StringFormat={}  {0}, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="Placed"
                        GroupName="DoorFilter"
                        Style="{StaticResource Segment}">
                        <TextBlock>
                            <Run Text="Placed" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountPlaced, StringFormat={}  {0}, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="Attention"
                        GroupName="DoorFilter"
                        Style="{StaticResource Segment}"
                        ToolTip="Modified, missing components, changed source doors, errors or needing review">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="13"
                                Height="13"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Status.Warning}"
                                Kind="AlertOutline" />
                            <TextBlock>
                                <Run Text="Attention" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountAttention, StringFormat={}  {0}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="NoAccessControl"
                        GroupName="DoorFilter"
                        Style="{StaticResource Segment}"
                        ToolTip="Doors decided to need no access control">
                        <TextBlock>
                            <Run Text="No access control" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountNoAccessControl, StringFormat={}  {0}, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton
                        Command="{Binding FilterCommand}"
                        CommandParameter="Ignored"
                        GroupName="DoorFilter"
                        Style="{StaticResource Segment}">
                        <TextBlock>
                            <Run Text="Ignored" /><Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding CountIgnored, StringFormat={}  {0}, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                </StackPanel>
            </Border>
        </DockPanel>

        <!--  ===== Grid + review workspace =====  -->
        <Grid x:Name="MainArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition x:Name="SplitterColumn" Width="12" />
                <ColumnDefinition
                    x:Name="WorkspaceColumn"
                    Width="380"
                    MinWidth="300"
                    MaxWidth="560" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Surface}">
                <Grid>
                    <DataGrid
                        x:Name="DoorGrid"
                        AutomationProperties.Name="Doors"
                        IsSynchronizedWithCurrentItem="False"
                        ItemsSource="{Binding RowsView}"
                        MouseDoubleClick="DoorGrid_MouseDoubleClick"
                        SelectionChanged="DoorGrid_SelectionChanged"
                        SelectionMode="Extended"
                        SizeChanged="DoorGrid_SizeChanged"
                        Style="{StaticResource SentinelGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                x:Name="StatusColumn"
                                Width="160"
                                MinWidth="160"
                                Header="Status"
                                SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding StatusText}">
                                            <materialDesign:PackIcon Style="{StaticResource StatusIcon}" />
                                            <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn
                                Width="0.6*"
                                MinWidth="64"
                                Header="Door"
                                SortMemberPath="Mark">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Mark}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding TypeName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn
                                Width="2*"
                                MinWidth="120"
                                Header="Access"
                                SortMemberPath="AccessOrRooms">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding AccessOrRooms}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding AccessOrRooms}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn
                                x:Name="SetColumn"
                                Width="76"
                                MinWidth="76"
                                Header="Set"
                                SortMemberPath="SetCode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding SetCode}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding SetName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn
                                Width="1.2*"
                                MinWidth="90"
                                Header="Reason"
                                SortMemberPath="Reason">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Foreground="{DynamicResource Text.Secondary}"
                                            Text="{Binding Reason}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Reason}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                x:Name="LevelColumn"
                                Width="90"
                                MinWidth="90"
                                Binding="{Binding Level}"
                                Header="Level" />
                            <DataGridTextColumn
                                x:Name="PartsColumn"
                                Width="60"
                                MinWidth="60"
                                Binding="{Binding ComponentsText}"
                                Header="Parts" />
                            <DataGridTextColumn
                                x:Name="ReviewColumn"
                                Width="96"
                                MinWidth="96"
                                Binding="{Binding ReviewText}"
                                Header="Review" />
                        </DataGrid.Columns>
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
                        </DataGrid.InputBindings>
                    </DataGrid>

                    <!--  Search / filter hides everything  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource Text.Tertiary}"
                            Kind="Magnify" />
                        <TextBlock
                            Margin="0,10,0,2"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Type.Heading}"
                            Text="No matching doors" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource Type.Secondary}"
                            Text="Try another search, or choose All in the filter." />
                    </StackPanel>

                    <!--  Empty state  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}">
                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource Text.Tertiary}"
                            Kind="DoorClosedLock" />
                        <TextBlock
                            Margin="0,12,0,4"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Type.Section}"
                            Text="No doors yet" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource Type.Secondary}"
                            Text="Sentinel reads the doors of the linked architectural model. Check the source next to the page title, then find the doors."
                            TextAlignment="Center" />
                        <Button
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding FindDoorsCommand}"
                            Style="{StaticResource Button.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DoorOpen" Style="{StaticResource ButtonIconLabel}" />
                                <TextBlock Text="Find doors" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter
                x:Name="WorkspaceSplitter"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Resize review panel"
                DragCompleted="WorkspaceSplitter_DragCompleted"
                ResizeBehavior="PreviousAndNext" />

            <views:DoorWorkspace
                x:Name="Workspace"
                Grid.Column="2"
                ui:Motion.FromY="0"
                ui:Motion.Reveal="True" />
        </Grid>

        <!--  ===== Selection action bar (floating; hidden while a preview runs – the review panel drives it) =====  -->
        <Border
            x:Name="ActionBar"
            Grid.Row="2"
            Margin="0,10,0,2"
            Padding="12,8"
            AutomationProperties.Name="Actions for the selected doors"
            Style="{StaticResource Floating}"
            Visibility="{Binding Preview.IsActive, Converter={StaticResource InverseBoolToVis}}">
            <DockPanel>
                <!--  Scope of every command on this bar  -->
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Accent.Text}"
                        Kind="CheckboxMultipleMarkedOutline"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        x:Name="SelectionLabel"
                        VerticalAlignment="Center"
                        Text="{Binding SelectionText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding SelectionText}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="MaxWidth" Value="240" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="MaxWidth" Value="560" />
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button
                        Margin="4,0,0,0"
                        Command="{Binding ClearSelectionCommand}"
                        Content="Clear"
                        Style="{StaticResource Button.Plain}"
                        ToolTip="Clear the selection (Esc in the list)"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!--  Overflow: infrequent commands  -->
                <Button
                    x:Name="MoreButton"
                    Width="32"
                    Height="32"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="More actions"
                    Click="MoreButton_Click"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="More actions for the selected doors"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Kind="DotsHorizontal" />
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreMenu">
                            <MenuItem Command="{Binding SuggestCommand}" Header="Suggest sets from rules…">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="AutoFix" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource MenuSeparator}" />
                            <MenuItem Command="{Binding UnassignCommand}" Header="Remove door set…">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="LinkVariantRemove" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding NoAccessControlCommand}" Header="Mark as no access control">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ShieldOffOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding IgnoreCommand}" Header="Ignore doors">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="EyeOffOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding UnignoreCommand}" Header="Stop ignoring" />
                            <Separator Style="{StaticResource MenuSeparator}" />
                            <MenuItem Command="{Binding ZoomCommand}" Header="{Binding ZoomText}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="MagnifyScan" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding ZoomAlternativeCommand}" Header="{Binding ZoomAlternativeText}" />
                            <MenuItem Command="{Binding SelectComponentsCommand}" Header="Select components in Revit" />
                            <MenuItem Command="{Binding SelectSourceDoorCommand}" Header="Select source door in Revit" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!--  Nothing selected: one useful action instead of a row of disabled buttons  -->
                <Button
                    HorizontalAlignment="Right"
                    Command="{Binding SuggestCommand}"
                    Style="{StaticResource Button.Plain}"
                    ToolTip="Suggest door sets for the unassigned doors in the list, using the rules page"
                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AutoFix" Style="{StaticResource ButtonIconLabel}" />
                        <TextBlock Text="Suggest sets from rules…" />
                    </StackPanel>
                </Button>

                <!--  Assign | Review and place | Update  -->
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <ComboBox
                        x:Name="AssignCombo"
                        Width="210"
                        AutomationProperties.Name="Door set to assign"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding Definitions}"
                        SelectedItem="{Binding AssignDefinition}"
                        Style="{StaticResource Input.Combo}"
                        ToolTip="Door set to assign to the selected doors" />
                    <Button
                        Margin="6,0,0,0"
                        ui:Emphasis.IsPrimary="{Binding IsAssignPrimary}"
                        Command="{Binding AssignCommand}"
                        Content="Assign"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Assign this door set to the selected doors (placed sets ask before changing)" />
                    <Rectangle Style="{StaticResource BarSeparator}" />
                    <!--  Split button: review first (default) or place directly  -->
                    <Button
                        ui:Emphasis.IsPrimary="{Binding IsReviewPrimary}"
                        Command="{Binding PreviewCommand}"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Walk through the selected doors with a preview in Revit, then place each one">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="EyeOutline" Style="{StaticResource ButtonIconLabel}" />
                            <TextBlock Text="Review and place" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PlaceOptionsButton"
                        Width="28"
                        MinWidth="0"
                        Margin="2,0,0,0"
                        Padding="0"
                        AutomationProperties.Name="More placement options"
                        Click="PlaceOptionsButton_Click"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Place without review">
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            Kind="ChevronDown" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="PlaceOptionsMenu">
                                <MenuItem Command="{Binding PlaceCommand}" Header="Place without review…">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="PlaylistCheck" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button
                        Margin="6,0,0,0"
                        ui:Emphasis.IsPrimary="{Binding IsUpdatePrimary}"
                        Command="{Binding UpdateCommand}"
                        Content="Update placement"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Move, add or delete placed components so they match the current set and door" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
