<UserControl
    x:Class="Sentinel.UI.Views.ComponentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="clr-namespace:Sentinel.UI"
    xmlns:views="clr-namespace:Sentinel.UI.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SharedDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style
                x:Key="FieldLabel"
                BasedOn="{StaticResource Type.Label}"
                TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  DataContext: ComponentsViewModel  -->
    <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ===== Library =====  -->
        <Border Style="{StaticResource Surface}">
            <DockPanel>
                <DockPanel Margin="14,12,8,6" DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            AutomationProperties.Name="New component"
                            Command="{Binding NewCommand}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="New component">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="Plus" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Duplicate component"
                            Command="{Binding DuplicateCommand}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Duplicate the selected component">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="ContentCopy" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Delete component"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Delete the selected component">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="DeleteOutline" />
                        </Button>
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource Type.Heading}"
                        Text="Library" />
                </DockPanel>
                <ListBox
                    Margin="6,0,6,6"
                    AutomationProperties.Name="Components"
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding Selected}"
                    Style="{StaticResource MasterList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <!--  Missing mapping: glyph + word, not colour alone  -->
                                <Border
                                    Margin="6,0,0,0"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Badge.Error}"
                                    ToolTip="No Revit family type mapped – components of this kind cannot be placed"
                                    Visibility="{Binding IsModelled, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="11"
                                            Height="11"
                                            Margin="0,0,3,0"
                                            VerticalAlignment="Center"
                                            Kind="AlertCircleOutline" />
                                        <TextBlock Text="Unmapped" />
                                    </StackPanel>
                                </Border>
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,1,0,0"
                                        Style="{StaticResource Type.Secondary}"
                                        Text="{Binding ModellingDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!--  ===== Editor =====  -->
        <Border Grid.Column="2" Style="{StaticResource Surface}">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <materialDesign:PackIcon
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Text.Tertiary}"
                        Kind="CardAccountDetailsOutline" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource Type.Secondary}"
                        Text="Select a component, or create one with +." />
                </StackPanel>

                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="20,16,20,20" IsEnabled="{Binding IsEditable}">
                        <!--  Identity  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                <TextBox
                                    AutomationProperties.Name="Name"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource Input.Text}"
                                    Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Category" />
                                <ComboBox
                                    AutomationProperties.Name="Category"
                                    DisplayMemberPath="Text"
                                    ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding Category}"
                                    Style="{StaticResource Input.Combo}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Margin="0,10,0,4"
                            Style="{StaticResource FieldLabel}"
                            Text="Description" />
                        <TextBox
                            AutomationProperties.Name="Description"
                            Style="{StaticResource Input.Text}"
                            Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />

                        <!--  How the component exists in Revit  -->
                        <TextBlock
                            Margin="0,24,0,4"
                            Style="{StaticResource Type.Section}"
                            Text="How it is modelled" />
                        <TextBlock
                            Margin="0,0,0,10"
                            Style="{StaticResource Type.Secondary}"
                            Text="As its own family, or as part of another component's family that is switched on with a Yes/No parameter (for example a lock inside the magnet contact)." />
                        <Border
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="How it is modelled"
                            Style="{StaticResource Segmented}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    Content="Its own family"
                                    GroupName="Modelling"
                                    IsChecked="{Binding IsOwnFamily}"
                                    Style="{StaticResource Segment}" />
                                <RadioButton
                                    Content="Part of another component"
                                    GroupName="Modelling"
                                    IsChecked="{Binding IsBuiltIn}"
                                    Style="{StaticResource Segment}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,12,0,0"
                            ui:Motion.FromY="-4"
                            ui:Motion.Reveal="True"
                            Style="{StaticResource Card}"
                            Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Carried by" />
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Tick every component whose Revit family contains this one. They all use the parameters below."
                                    TextWrapping="Wrap" />
                                <ItemsControl
                                    Margin="0,0,0,12"
                                    AutomationProperties.Name="Carried by"
                                    ItemsSource="{Binding CarrierChoices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Margin="0,0,16,6"
                                                AutomationProperties.Name="{Binding Name}"
                                                Content="{Binding Name}"
                                                IsChecked="{Binding IsChecked}"
                                                Style="{StaticResource Input.Check}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Parameter when on the left" />
                                        <TextBox
                                            AutomationProperties.Name="Yes/No parameter when on the left"
                                            Style="{StaticResource Input.Text}"
                                            Tag="e.g. Lukk vasakul"
                                            Text="{Binding CarrierParameterLeft, UpdateSourceTrigger=LostFocus}"
                                            ToolTip="Yes/No instance parameter of the carrier family" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Parameter when on the right" />
                                        <TextBox
                                            AutomationProperties.Name="Yes/No parameter when on the right"
                                            Style="{StaticResource Input.Text}"
                                            Tag="e.g. Lukk paremal"
                                            Text="{Binding CarrierParameterRight, UpdateSourceTrigger=LostFocus}"
                                            ToolTip="Yes/No instance parameter of the carrier family" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Left and right as seen from the front of the carrier family (Revit's Front view). The other side's parameter is switched off." />
                                <CheckBox
                                    Margin="0,10,0,0"
                                    Content="The family defines left and right the other way round"
                                    IsChecked="{Binding SwapCarrierSides}"
                                    Style="{StaticResource Input.Check}" />
                                <CheckBox
                                    Margin="0,6,0,0"
                                    Content="Use the own family below when a door set has no carrier"
                                    IsChecked="{Binding UseOwnFamilyAsBackup}"
                                    Style="{StaticResource Input.Check}" />

                                <!--  What will happen, in words; amber until the setup is complete  -->
                                <Border
                                    Margin="0,12,0,0"
                                    Padding="10,8"
                                    CornerRadius="{StaticResource Radius.Control}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="{DynamicResource Status.Info.Subtle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BuiltInIsOk}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource Status.Warning.Subtle}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <materialDesign:PackIcon
                                            Width="15"
                                            Height="15"
                                            Margin="0,1,8,0"
                                            VerticalAlignment="Top">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                    <Setter Property="Kind" Value="InformationOutline" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Info}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BuiltInIsOk}" Value="False">
                                                            <Setter Property="Kind" Value="AlertOutline" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource Type.Secondary}"
                                            Foreground="{DynamicResource Text.Primary}"
                                            Text="{Binding BuiltInSummary}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!--  Family mapping (the backup for built-in components)  -->
                        <TextBlock
                            Margin="0,24,0,10"
                            Style="{StaticResource Type.Section}"
                            Text="{Binding FamilySectionTitle}" />
                        <Border Padding="12,10">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Background" Value="{DynamicResource Status.Ok.Subtle}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Surface.Stroke}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MappingIsOk}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource Status.Error.Subtle}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Status.Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="{x:Type materialDesign:PackIcon}">
                                            <Setter Property="Kind" Value="CheckCircle" />
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Ok}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MappingIsOk}" Value="False">
                                                    <Setter Property="Kind" Value="AlertCircleOutline" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <Button
                                    Command="{Binding ClearMappingCommand}"
                                    Content="Clear mapping"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Button.Plain}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Type.Body}"
                                    Text="{Binding MappingText}" />
                            </DockPanel>
                        </Border>

                        <DockPanel Margin="0,12,0,8">
                            <Button
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Reload families from the model"
                                Command="{Binding LoadFamiliesCommand}"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Reload the family types loaded in the project">
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Kind="Refresh" />
                            </Button>
                            <CheckBox
                                Margin="12,0,0,0"
                                Content="Show unsupported"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding ShowUnsupported}"
                                Style="{StaticResource Input.Check}"
                                ToolTip="Supported: face-based / work-plane-based and level-based families" />
                            <Grid>
                                <TextBox
                                    Padding="30,0,10,0"
                                    AutomationProperties.Name="Filter family types"
                                    Style="{StaticResource Input.Text}"
                                    Tag="Filter by family, type or category"
                                    Text="{Binding FamilyFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Text.Tertiary}"
                                    IsHitTestVisible="False"
                                    Kind="Magnify" />
                            </Grid>
                        </DockPanel>
                        <Border Height="200" Style="{StaticResource InsetCard}" Padding="4">
                            <ListBox
                                AutomationProperties.Name="Loaded family types"
                                IsSynchronizedWithCurrentItem="False"
                                ItemsSource="{Binding FamilyTypesView}"
                                SelectedItem="{Binding SelectedFamilyType}"
                                Style="{StaticResource MasterList}"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock
                                                Margin="10,0,0,0"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource Type.Caption}"
                                                Text="{Binding PlacementType}" />
                                            <TextBlock
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource Type.Caption}"
                                                Text="{Binding CategoryName}" />
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!--  Behaviour  -->
                        <TextBlock
                            Margin="0,24,0,10"
                            Style="{StaticResource Type.Section}"
                            Text="Placement behaviour" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Default height (mm)" />
                                <TextBox
                                    AutomationProperties.Name="Default mounting height in millimetres"
                                    Style="{StaticResource Input.Text}"
                                    Text="{Binding DefaultHeight, UpdateSourceTrigger=PropertyChanged, Delay=250, ValidatesOnDataErrors=True}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Hosting" />
                                <ComboBox
                                    AutomationProperties.Name="Hosting"
                                    DisplayMemberPath="Text"
                                    ItemsSource="{Binding HostBehaviors}"
                                    SelectedItem="{Binding HostBehavior}"
                                    Style="{StaticResource Input.Combo}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Rotation offset (°)" />
                                <TextBox
                                    AutomationProperties.Name="Rotation offset in degrees"
                                    Style="{StaticResource Input.Text}"
                                    Text="{Binding RotationOffset, UpdateSourceTrigger=PropertyChanged, Delay=250, ValidatesOnDataErrors=True}"
                                    ToolTip="Unhosted families: Sentinel assumes the device front is the family's local -Y axis. Use 180 if the front is +Y." />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Preview size (mm)" />
                                <TextBox
                                    AutomationProperties.Name="Preview size in millimetres"
                                    Style="{StaticResource Input.Text}"
                                    Text="{Binding PreviewSize, UpdateSourceTrigger=PropertyChanged, Delay=250, ValidatesOnDataErrors=True}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,24,0,4"
                            Style="{StaticResource Type.Section}"
                            Text="Default placement" />
                        <TextBlock
                            Margin="0,0,0,10"
                            Style="{StaticResource Type.Secondary}"
                            Text="Used when this component is added to a set type." />
                        <views:RuleEditorControl DataContext="{Binding DefaultRule}" />

                        <!--  Parameters (progressive disclosure: rarely changed)  -->
                        <ToggleButton
                            x:Name="ParamsToggle"
                            Margin="-4,20,0,6"
                            Content="Parameters written on placement"
                            Style="{StaticResource Toggle.Disclosure}" />
                        <StackPanel Margin="18,0,0,0" Visibility="{Binding IsChecked, ElementName=ParamsToggle, Converter={StaticResource BoolToVis}}">
                            <ItemsControl Focusable="False" ItemsSource="{Binding Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button
                                                Margin="6,0,0,0"
                                                AutomationProperties.Name="Remove parameter"
                                                Command="{Binding RemoveCommand}"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource Button.Icon}"
                                                ToolTip="Remove parameter">
                                                <materialDesign:PackIcon Kind="DeleteOutline" />
                                            </Button>
                                            <TextBox
                                                Width="200"
                                                Margin="0,0,6,0"
                                                AutomationProperties.Name="Parameter name"
                                                Style="{StaticResource Input.Text}"
                                                Tag="Instance parameter"
                                                Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                                            <TextBox
                                                AutomationProperties.Name="Parameter value"
                                                Style="{StaticResource Input.Text}"
                                                Tag="Value (numbers in project units)"
                                                Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                HorizontalAlignment="Left"
                                Command="{Binding AddParameterCommand}"
                                Style="{StaticResource Button.Secondary}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Kind="Plus" />
                                    <TextBlock Text="Add parameter" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <DockPanel Margin="0,16,0,0">
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,8,0"
                                VerticalAlignment="Top"
                                Foreground="{DynamicResource Text.Tertiary}"
                                Kind="InformationOutline" />
                            <TextBlock Style="{StaticResource Type.Secondary}" Text="{Binding UsageText}" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
