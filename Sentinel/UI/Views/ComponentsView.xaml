<UserControl
    x:Class="Sentinel.UI.Views.ComponentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:views="clr-namespace:Sentinel.UI.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  DataContext: ComponentsViewModel  -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Panel}">
            <DockPanel>
                <TextBlock
                    Margin="0,0,0,8"
                    DockPanel.Dock="Top"
                    Style="{StaticResource PageTitleText}"
                    Text="Components" />
                <WrapPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                    <Button
                        Command="{Binding NewCommand}"
                        Content="New"
                        Style="{StaticResource ActionButton}" />
                    <Button
                        Command="{Binding DuplicateCommand}"
                        Content="Duplicate"
                        Style="{StaticResource ActionButton}" />
                    <Button
                        Command="{Binding DeleteCommand}"
                        Content="Delete"
                        Style="{StaticResource ActionButton}" />
                </WrapPanel>
                <ListBox
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding Selected}"
                    Style="{StaticResource MasterList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right"
                                    Foreground="{DynamicResource WarningBrush}"
                                    Kind="AlertOutline"
                                    ToolTip="Family not configured"
                                    Visibility="{Binding IsFamilyConfigured, Converter={StaticResource InverseBoolToVis}}" />
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource BodyText}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionText}"
                                        Text="{Binding FamilyDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border
            Grid.Column="2"
            Padding="0"
            Style="{StaticResource Panel}">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionText}"
                    Text="Select or create a component."
                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="14,12" IsEnabled="{Binding IsEditable}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="Name" />
                            <TextBox
                                Grid.Column="1"
                                Margin="0,2"
                                Style="{StaticResource InputTextBox}"
                                Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock
                                Grid.Column="3"
                                Style="{StaticResource LabelText}"
                                Text="Category" />
                            <ComboBox
                                Grid.Column="4"
                                Margin="0,2"
                                DisplayMemberPath="Text"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding Category}"
                                Style="{StaticResource InputComboBox}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource LabelText}"
                                Text="Description" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="4"
                                Margin="0,2"
                                Style="{StaticResource InputTextBox}"
                                Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <!--  Family mapping  -->
                        <TextBlock Style="{StaticResource SectionCaption}" Text="REVIT FAMILY TYPE" />
                        <DockPanel>
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Foreground="{DynamicResource OkBrush}"
                                Kind="CheckCircleOutline"
                                Visibility="{Binding MappingIsOk, Converter={StaticResource BoolToVis}}" />
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Foreground="{DynamicResource WarningBrush}"
                                Kind="AlertOutline"
                                Visibility="{Binding MappingIsOk, Converter={StaticResource InverseBoolToVis}}" />
                            <Button
                                Command="{Binding ClearMappingCommand}"
                                Content="Clear"
                                DockPanel.Dock="Right"
                                Style="{StaticResource ActionButton}" />
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding MappingText}" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,4">
                            <Button
                                Margin="6,0,0,0"
                                Command="{Binding LoadFamiliesCommand}"
                                Content="Reload families"
                                DockPanel.Dock="Right"
                                Style="{StaticResource ActionButton}" />
                            <CheckBox
                                Margin="10,0,0,0"
                                Content="Show unsupported"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding ShowUnsupported}"
                                Style="{StaticResource InputCheckBox}"
                                ToolTip="Supported: face-based / work-plane-based and level-based families." />
                            <Grid>
                                <TextBox
                                    x:Name="FamilyFilterBox"
                                    Style="{StaticResource InputTextBox}"
                                    Text="{Binding FamilyFilter, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource IconForegroundBrush}"
                                    IsHitTestVisible="False"
                                    Text="Filter loaded families (name, type, category)…"
                                    Visibility="{Binding Text, ElementName=FamilyFilterBox, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </DockPanel>
                        <Border
                            Height="190"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ListBox
                                IsSynchronizedWithCurrentItem="False"
                                ItemsSource="{Binding FamilyTypesView}"
                                SelectedItem="{Binding SelectedFamilyType}"
                                Style="{StaticResource MasterList}"
                                VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource CaptionText}"
                                                Text="{Binding PlacementType}" />
                                            <TextBlock
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource CaptionText}"
                                                Text="{Binding CategoryName}" />
                                            <TextBlock
                                                Style="{StaticResource BodyText}"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!--  Behaviour  -->
                        <TextBlock Style="{StaticResource SectionCaption}" Text="PLACEMENT BEHAVIOUR" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="Default height (mm)" />
                            <TextBox
                                Grid.Column="1"
                                Margin="0,2"
                                Style="{StaticResource InputTextBox}"
                                Text="{Binding DefaultHeight, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" />
                            <TextBlock
                                Grid.Column="3"
                                Style="{StaticResource LabelText}"
                                Text="Hosting" />
                            <ComboBox
                                Grid.Column="4"
                                Margin="0,2"
                                DisplayMemberPath="Text"
                                ItemsSource="{Binding HostBehaviors}"
                                SelectedItem="{Binding HostBehavior}"
                                Style="{StaticResource InputComboBox}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource LabelText}"
                                Text="Rotation offset (°)" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,2"
                                Style="{StaticResource InputTextBox}"
                                Text="{Binding RotationOffset, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                ToolTip="Unhosted families: Sentinel assumes the device front is the family's local -Y axis. Use 180 if the front is +Y." />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="3"
                                Style="{StaticResource LabelText}"
                                Text="Preview size (mm)" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="4"
                                Margin="0,2"
                                Style="{StaticResource InputTextBox}"
                                Text="{Binding PreviewSize, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" />
                        </Grid>

                        <TextBlock Style="{StaticResource SectionCaption}" Text="DEFAULT PLACEMENT RULE (used when added to a set)" />
                        <views:RuleEditorControl DataContext="{Binding DefaultRule}" />

                        <TextBlock Style="{StaticResource SectionCaption}" Text="PARAMETERS WRITTEN ON PLACEMENT" />
                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button
                                            Command="{Binding RemoveCommand}"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="Remove">
                                            <materialDesign:PackIcon Kind="DeleteOutline" />
                                        </Button>
                                        <TextBox
                                            Width="200"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource InputTextBox}"
                                            Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                            ToolTip="Instance parameter name" />
                                        <TextBox
                                            Margin="0,0,6,0"
                                            Style="{StaticResource InputTextBox}"
                                            Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                            ToolTip="Value (numbers in project units)" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            HorizontalAlignment="Left"
                            Command="{Binding AddParameterCommand}"
                            Content="Add parameter"
                            Style="{StaticResource ActionButton}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource CaptionText}"
                            Text="{Binding UsageText}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
