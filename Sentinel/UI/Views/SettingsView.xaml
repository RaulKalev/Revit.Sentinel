<UserControl
    x:Class="Sentinel.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="clr-namespace:Sentinel.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SharedDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Grouped settings: a card of rows, label left and control right, hairlines between rows  -->
            <Style x:Key="GroupTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{StaticResource FontSize.Emphasis}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                <Setter Property="Margin" Value="4,24,0,8" />
            </Style>
            <Style x:Key="SettingRow" TargetType="{x:Type DockPanel}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Margin" Value="14,0" />
            </Style>
            <Style x:Key="RowLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,10,16,10" />
            </Style>
            <Style x:Key="RowValue" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Input.Text}">
                <Setter Property="Width" Value="120" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
            <Style x:Key="Hairline" TargetType="{x:Type Rectangle}">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="14,0,0,0" />
                <Setter Property="Fill" Value="{DynamicResource Separator}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  DataContext: SettingsViewModel  -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="760"
            Margin="0,0,16,16"
            HorizontalAlignment="Left">
            <TextBlock
                Margin="4,0,0,0"
                Style="{StaticResource Type.Secondary}"
                Text="Project settings are stored in the Revit project together with the Sentinel data." />

            <StackPanel IsEnabled="{Binding IsEditable}">
                <!--  Zoom and preview (used every day, so first)  -->
                <TextBlock Style="{StaticResource GroupTitle}" Text="Zoom and preview" />
                <Border Padding="0,2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <Border
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Zoom to doors in"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Segmented}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        Content="Floor plan"
                                        GroupName="ZoomView"
                                        IsChecked="{Binding ZoomInFloorPlan}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="Open a floor plan of the door's level (your active plan when it is on that level)" />
                                    <RadioButton
                                        Content="3D view"
                                        GroupName="ZoomView"
                                        IsChecked="{Binding ZoomIn3D}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="Open a 3D view with a section box around the door" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,10,16,10" VerticalAlignment="Center">
                                <TextBlock Foreground="{DynamicResource Text.Primary}" Text="Zoom to doors in" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Also used by the preview's auto zoom. The other view stays one click away in the review panel." />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Hairline}" />
                        <CheckBox
                            Margin="14,12"
                            Content="In 3D, use the active 3D view instead of the 'Sentinel Focus' view"
                            IsChecked="{Binding PreviewInActiveView}"
                            Style="{StaticResource Input.Check}" />
                    </StackPanel>
                </Border>

                <!--  Doors modelled in several links  -->
                <TextBlock Style="{StaticResource GroupTitle}" Text="Doors in several models" />
                <Border Padding="0,2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock
                            Margin="14,12,14,8"
                            Style="{StaticResource Type.Caption}"
                            Text="When the same door is modelled in more than one linked model, only the door from the highest model is listed. The others are shown under Ignored."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="14,0,14,12"
                            Style="{StaticResource Type.Secondary}"
                            Text="Find doors on the Doors page to list the linked models here."
                            Visibility="{Binding HasLinkPriority, Converter={StaticResource InverseBoolToVis}}" />
                        <ItemsControl
                            Margin="0,0,0,6"
                            AutomationProperties.Name="Model priority"
                            ItemsSource="{Binding LinkPriority}"
                            Visibility="{Binding HasLinkPriority, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="14,2,8,2">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button
                                                AutomationProperties.Name="Move up"
                                                Command="{Binding DataContext.MoveLinkUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Button.Icon}"
                                                ToolTip="Higher priority">
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    Kind="ChevronUp" />
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="Move down"
                                                Command="{Binding DataContext.MoveLinkDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Button.Icon}"
                                                ToolTip="Lower priority">
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    Kind="ChevronDown" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock
                                            Width="22"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Text.Tertiary}"
                                            Text="{Binding Rank}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Text.Primary}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  Door handing  -->
                <TextBlock Style="{StaticResource GroupTitle}" Text="Door handing" />
                <Border Padding="0,2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Margin="14,12,14,10">
                            <CheckBox
                                Content="Hinge is on the HandOrientation side of Revit door families"
                                IsChecked="{Binding HingeOnHandSide}"
                                Style="{StaticResource Input.Check}" />
                            <TextBlock
                                Margin="26,4,0,0"
                                Style="{StaticResource Type.Secondary}"
                                Text="Families differ in how they are authored. Preview one door; if readers land on the hinge side, change this. Single doors can always be corrected with Swap hinge." />
                        </StackPanel>
                        <Rectangle Style="{StaticResource Hairline}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ComboBox
                                Width="220"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Assumed hinge when unknown"
                                DisplayMemberPath="Text"
                                DockPanel.Dock="Right"
                                ItemsSource="{Binding HingeSides}"
                                SelectedItem="{Binding DefaultHinge}"
                                Style="{StaticResource Input.Combo}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Assumed hinge when unknown (IFC doors)" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!--  Source data  -->
                <TextBlock Style="{StaticResource GroupTitle}" Text="Source data" />
                <Border Padding="0,2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Margin="14,12,14,12">
                            <TextBlock
                                Margin="0,0,0,6"
                                Style="{StaticResource Type.Body}"
                                Text="Captured door parameters" />
                            <TextBox
                                AutomationProperties.Name="Captured door parameters"
                                Style="{StaticResource Input.MultiLine}"
                                Tag="Comma separated, for example FireRating, SecurityClass"
                                Text="{Binding CapturedParameters, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource Type.Caption}"
                                Text="Shown in the review panel, compared for source changes and available in rules." />
                        </StackPanel>
                        <Rectangle Style="{StaticResource Hairline}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox
                                AutomationProperties.Name="Room probe distance in millimetres"
                                DockPanel.Dock="Right"
                                Style="{StaticResource RowValue}"
                                Text="{Binding RoomProbeDistance, UpdateSourceTrigger=PropertyChanged, Delay=300, ValidatesOnDataErrors=True}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Room probe distance (mm)" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Hairline}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox
                                AutomationProperties.Name="Wall face search distance in millimetres"
                                DockPanel.Dock="Right"
                                Style="{StaticResource RowValue}"
                                Text="{Binding WallSearchDistance, UpdateSourceTrigger=PropertyChanged, Delay=300, ValidatesOnDataErrors=True}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Wall face search distance (mm)" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!--  Change detection  -->
                <TextBlock Style="{StaticResource GroupTitle}" Text="Change detection" />
                <Border Padding="0,2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox
                                AutomationProperties.Name="Door moved tolerance in millimetres"
                                DockPanel.Dock="Right"
                                Style="{StaticResource RowValue}"
                                Text="{Binding SourceMoveTolerance, UpdateSourceTrigger=PropertyChanged, Delay=300, ValidatesOnDataErrors=True}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Source door moved (mm)" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Hairline}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox
                                AutomationProperties.Name="Door rotated tolerance in degrees"
                                DockPanel.Dock="Right"
                                Style="{StaticResource RowValue}"
                                Text="{Binding SourceRotationTolerance, UpdateSourceTrigger=PropertyChanged, Delay=300, ValidatesOnDataErrors=True}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Source door rotated (°)" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Hairline}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox
                                AutomationProperties.Name="Door size tolerance in millimetres"
                                DockPanel.Dock="Right"
                                Style="{StaticResource RowValue}"
                                Text="{Binding SourceSizeTolerance, UpdateSourceTrigger=PropertyChanged, Delay=300, ValidatesOnDataErrors=True}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Source door resized (mm)" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Hairline}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox
                                AutomationProperties.Name="Manual move tolerance in millimetres"
                                DockPanel.Dock="Right"
                                Style="{StaticResource RowValue}"
                                Text="{Binding ComponentMoveTolerance, UpdateSourceTrigger=PropertyChanged, Delay=300, ValidatesOnDataErrors=True}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Component moved by hand (mm)" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Hairline}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox
                                AutomationProperties.Name="Manual rotation tolerance in degrees"
                                DockPanel.Dock="Right"
                                Style="{StaticResource RowValue}"
                                Text="{Binding ComponentRotationTolerance, UpdateSourceTrigger=PropertyChanged, Delay=300, ValidatesOnDataErrors=True}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Component rotated by hand (°)" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!--  Placement  -->
                <TextBlock Style="{StaticResource GroupTitle}" Text="Placement" />
                <Border Padding="0,2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox
                                Width="220"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Identity text parameter"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Input.Text}"
                                Tag="Optional"
                                Text="{Binding IdentityParameterName, UpdateSourceTrigger=LostFocus}"
                                ToolTip="If set, placed elements get 'SetCode / DoorMark' in this instance text parameter (for schedules)" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Identity text parameter" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Library  -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="Library" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Type.Secondary}" Text="Share components, door set types and rules between projects. Door assignments stay in this project." />
                    <WrapPanel Margin="0,10,0,0">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding ExportCommand}"
                            Content="Export library…"
                            Style="{StaticResource Button.Secondary}" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding ImportCommand}"
                            Content="Import library…"
                            Style="{StaticResource Button.Secondary}" />
                        <Button
                            Command="{Binding AddStarterCommand}"
                            Content="Add missing starter components"
                            Style="{StaticResource Button.Plain}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Data  -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="About this data" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Type.Label}" Text="Project" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,3"
                        Style="{StaticResource Type.Body}"
                        Text="{Binding DocumentText}" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource Type.Label}"
                        Text="Data format" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,3"
                        Style="{StaticResource Type.Body}"
                        Text="{Binding DataVersionText}" />
                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource Type.Label}"
                        Text="Contents" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,3"
                        Style="{StaticResource Type.Body}"
                        Text="{Binding CountsText}" />
                    <TextBlock
                        Grid.Row="3"
                        Style="{StaticResource Type.Label}"
                        Text="Sentinel project id" />
                    <TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        AutomationProperties.Name="Sentinel project id"
                        FontFamily="{StaticResource Font.Mono}"
                        Style="{StaticResource Input.ReadOnlyValue}"
                        Text="{Binding ProjectIdText, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="4"
                        Style="{StaticResource Type.Label}"
                        Text="Log file" />
                    <TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        AutomationProperties.Name="Log file path"
                        Style="{StaticResource Input.ReadOnlyValue}"
                        Text="{Binding LogPathText, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="5"
                        Style="{StaticResource Type.Label}"
                        Text="Version" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="0,3"
                        Style="{StaticResource Type.Body}"
                        Text="{Binding VersionText}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
