<UserControl
    x:Class="Sentinel.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  DataContext: SettingsViewModel  -->
    <Border Padding="0" Style="{StaticResource Panel}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" Margin="16,12" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource PageTitleText}" Text="Settings" />
                <TextBlock Style="{StaticResource CaptionText}" Text="Project settings are stored in the Revit project together with the Sentinel data." />

                <StackPanel IsEnabled="{Binding IsEditable}">
                    <TextBlock Style="{StaticResource SectionCaption}" Text="DOOR HANDING" />
                    <CheckBox
                        Content="Hinge is on the HandOrientation side of Revit door families"
                        IsChecked="{Binding HingeOnHandSide}"
                        Style="{StaticResource InputCheckBox}" />
                    <TextBlock
                        Margin="21,2,0,6"
                        Style="{StaticResource CaptionText}"
                        Text="Door families differ in how they are authored. Check one placed door in the preview; if readers land on the hinge side, toggle this. Individual doors can always be corrected with 'Swap hinge'." />
                    <DockPanel>
                        <TextBlock
                            Width="230"
                            Style="{StaticResource LabelText}"
                            Text="Assumed hinge when unknown (IFC)" />
                        <ComboBox
                            Width="220"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="Text"
                            ItemsSource="{Binding HingeSides}"
                            SelectedItem="{Binding DefaultHinge}"
                            Style="{StaticResource InputComboBox}" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource SectionCaption}" Text="SOURCE DATA" />
                    <TextBlock Style="{StaticResource LabelText}" Text="Captured door parameters (comma separated) – shown in the inspector, compared for changes and usable in rules" />
                    <TextBox
                        Margin="0,4,0,0"
                        Style="{StaticResource MultiLineTextBox}"
                        Text="{Binding CapturedParameters, UpdateSourceTrigger=LostFocus}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource LabelText}" Text="Room probe distance (mm)" />
                        <TextBox Grid.Column="1" Margin="0,2" Style="{StaticResource InputTextBox}" Text="{Binding RoomProbeDistance, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource LabelText}" Text="Door moved tolerance (mm)" />
                        <TextBox Grid.Column="4" Margin="0,2" Style="{StaticResource InputTextBox}" Text="{Binding SourceMoveTolerance, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="Door rotated tolerance (°)" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Style="{StaticResource InputTextBox}" Text="{Binding SourceRotationTolerance, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource LabelText}" Text="Door size tolerance (mm)" />
                        <TextBox Grid.Row="1" Grid.Column="4" Margin="0,2" Style="{StaticResource InputTextBox}" Text="{Binding SourceSizeTolerance, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Text="Manual move tolerance (mm)" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Style="{StaticResource InputTextBox}" Text="{Binding ComponentMoveTolerance, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource LabelText}" Text="Manual rotation tolerance (°)" />
                        <TextBox Grid.Row="2" Grid.Column="4" Margin="0,2" Style="{StaticResource InputTextBox}" Text="{Binding ComponentRotationTolerance, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource LabelText}" Text="Wall face search distance (mm)" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Style="{StaticResource InputTextBox}" Text="{Binding WallSearchDistance, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SectionCaption}" Text="PLACEMENT AND PREVIEW" />
                    <DockPanel>
                        <TextBlock
                            Width="230"
                            Style="{StaticResource LabelText}"
                            Text="Identity text parameter (optional)" />
                        <TextBox
                            Width="220"
                            HorizontalAlignment="Left"
                            Style="{StaticResource InputTextBox}"
                            Text="{Binding IdentityParameterName, UpdateSourceTrigger=LostFocus}"
                            ToolTip="If set, placed elements get 'SetCode / DoorMark' in this instance text parameter (e.g. for schedules)." />
                    </DockPanel>
                    <CheckBox
                        Margin="0,8,0,0"
                        Content="Preview and zoom in the active 3D view instead of the 'Sentinel Focus' view"
                        IsChecked="{Binding PreviewInActiveView}"
                        Style="{StaticResource InputCheckBox}" />
                </StackPanel>

                <TextBlock Style="{StaticResource SectionCaption}" Text="LIBRARY" />
                <TextBlock Style="{StaticResource CaptionText}" Text="Share components, door set types and rules between projects. Door set instances stay in the project." />
                <WrapPanel Margin="0,6,0,0">
                    <Button
                        Command="{Binding ExportCommand}"
                        Content="Export library…"
                        Style="{StaticResource ActionButton}" />
                    <Button
                        Command="{Binding ImportCommand}"
                        Content="Import library…"
                        Style="{StaticResource ActionButton}" />
                    <Button
                        Command="{Binding AddStarterCommand}"
                        Content="Add missing starter components"
                        Style="{StaticResource ActionButton}" />
                </WrapPanel>

                <TextBlock Style="{StaticResource SectionCaption}" Text="DATA" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource LabelText}" Text="Project" />
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding DocumentText}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="Data format" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding DataVersionText}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Text="Contents" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding CountsText}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource LabelText}" Text="Sentinel project id" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="-4,1,0,1" Background="Transparent" BorderThickness="0" IsReadOnly="True" Style="{StaticResource InputTextBox}" Text="{Binding ProjectIdText, Mode=OneWay}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource LabelText}" Text="Log file" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="-4,1,0,1" Background="Transparent" BorderThickness="0" IsReadOnly="True" Style="{StaticResource InputTextBox}" Text="{Binding LogPathText, Mode=OneWay}" />
                    <TextBlock Grid.Row="5" Style="{StaticResource LabelText}" Text="Version" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding VersionText}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
