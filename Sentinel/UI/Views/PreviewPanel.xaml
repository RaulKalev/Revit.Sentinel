<UserControl
    x:Class="Sentinel.UI.Views.PreviewPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  DataContext: PreviewViewModel  -->
    <Border
        Margin="0,0,0,14"
        Padding="10"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="1.5"
        CornerRadius="6">
        <StackPanel>
            <DockPanel>
                <Button
                    Command="{Binding ExitCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource IconButton}"
                    ToolTip="Exit preview (clears the preview graphics)">
                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Kind="CloseCircleOutline" />
                </Button>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentBrush}"
                        Kind="EyeOutline" />
                    <TextBlock Style="{StaticResource HeaderText}" Text="PREVIEW" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding PositionText}" />
                </StackPanel>
            </DockPanel>

            <TextBlock
                Margin="0,8,0,0"
                FontSize="17"
                Style="{StaticResource PageTitleText}"
                Text="{Binding DoorTitle, StringFormat=Door {0}}" />
            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding RoomsText}" />

            <DockPanel Margin="0,8,0,0">
                <TextBlock
                    Width="70"
                    Style="{StaticResource LabelText}"
                    Text="Door set" />
                <ComboBox
                    DisplayMemberPath="Text"
                    ItemsSource="{Binding SetChoices}"
                    SelectedItem="{Binding SelectedSet}"
                    Style="{StaticResource InputComboBox}"
                    ToolTip="Change Set: the preview updates immediately." />
            </DockPanel>
            <DockPanel Margin="0,6,0,0">
                <TextBlock
                    Width="70"
                    Style="{StaticResource LabelText}"
                    Text="Access" />
                <TextBlock
                    FontWeight="SemiBold"
                    Style="{StaticResource BodyText}"
                    Text="{Binding AccessText}" />
            </DockPanel>
            <DockPanel Margin="0,2,0,0">
                <TextBlock
                    Width="70"
                    Style="{StaticResource LabelText}"
                    Text="Hinge" />
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding HingeText}" />
            </DockPanel>

            <UniformGrid
                Margin="0,10,0,0"
                Columns="2">
                <Button
                    Margin="0,0,4,4"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource ActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="ChevronLeft" />
                        <TextBlock Text="Previous" />
                    </StackPanel>
                </Button>
                <Button
                    Margin="4,0,0,4"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource ActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Next" />
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Kind="ChevronRight" />
                    </StackPanel>
                </Button>
                <Button
                    Margin="0,0,4,4"
                    Command="{Binding FlipCommand}"
                    Content="Flip Set"
                    Style="{StaticResource ActionButton}"
                    ToolTip="Swap the access direction (reader ↔ REX sides)" />
                <Button
                    Margin="4,0,0,4"
                    Command="{Binding SwapHingeCommand}"
                    Content="Swap hinge"
                    Style="{StaticResource ActionButton}" />
                <Button
                    Margin="0,0,4,4"
                    Command="{Binding EditComponentsCommand}"
                    Content="Edit Components"
                    Style="{StaticResource ActionButton}"
                    ToolTip="Edit this door's components in the inspector below" />
                <Button
                    Margin="4,0,0,4"
                    Command="{Binding ZoomCommand}"
                    Content="Zoom"
                    Style="{StaticResource ActionButton}" />
                <Button
                    Margin="0,0,4,0"
                    Command="{Binding SkipCommand}"
                    Content="Skip"
                    Style="{StaticResource ActionButton}"
                    ToolTip="Leave this door unplaced and go to the next one" />
                <Button
                    Margin="4,0,0,0"
                    Command="{Binding ConfirmCommand}"
                    Content="{Binding ConfirmText}"
                    Style="{StaticResource PrimaryButton}"
                    ToolTip="Place this door set now and go to the next door" />
            </UniformGrid>
            <CheckBox
                Margin="0,8,0,0"
                Content="Zoom to each door"
                IsChecked="{Binding AutoZoom}"
                Style="{StaticResource InputCheckBox}" />

            <TextBlock
                Margin="0,8,0,0"
                Foreground="{DynamicResource AccentBrush}"
                Style="{StaticResource CaptionText}"
                Text="{Binding OutcomeText}"
                Visibility="{Binding OutcomeText, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{DynamicResource WarningBrush}"
                Style="{StaticResource CaptionText}"
                Text="{Binding PlanIssuesText}"
                Visibility="{Binding HasPlanIssues, Converter={StaticResource BoolToVis}}" />

            <TextBlock Style="{StaticResource SectionCaption}" Text="PROPOSED LOCATIONS" />
            <ItemsControl ItemsSource="{Binding Placements}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Explanation}" />
                            <TextBlock
                                Foreground="{DynamicResource ErrorBrush}"
                                Style="{StaticResource CaptionText}"
                                Text="{Binding IssuesText}"
                                Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource CaptionText}"
                Text="Preview graphics are temporary (not part of the model). Boxes show devices, arrows their facing; the green arrow is the controlled direction." />
        </StackPanel>
    </Border>
</UserControl>
