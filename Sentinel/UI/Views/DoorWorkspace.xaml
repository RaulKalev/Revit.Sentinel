<UserControl
    x:Class="Sentinel.UI.Views.DoorWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="clr-namespace:Sentinel.UI"
    xmlns:views="clr-namespace:Sentinel.UI.Views"
    AutomationProperties.Name="Review panel">
    <!--
        One review workspace for inspection and preview (DataContext: DoorsViewModel).
        Sticky header = which door, its state and issues (+ preview position and navigation while previewing).
        Scrolling middle = components, source door and notes.
        Sticky footer = set, direction, flip and hinge, plus the preview confirmation (Skip / Place and next).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SharedDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{StaticResource FontSize.Secondary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="FieldRow" TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="KeyText" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{StaticResource FontSize.Secondary}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                <Setter Property="Margin" Value="0,2,10,2" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style x:Key="ValueText" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{StaticResource FontSize.Secondary}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Surface}">
        <Grid>
            <!--  Nothing / several doors selected  -->
            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding Inspector.HasRow, Converter={StaticResource InverseBoolToVis}}">
                <materialDesign:PackIcon
                    Width="34"
                    Height="34"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource Text.Tertiary}"
                    Kind="CursorDefaultClickOutline" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Type.Secondary}"
                    Text="{Binding Inspector.MultiSelectText}"
                    TextAlignment="Center" />
            </StackPanel>

            <DockPanel DataContext="{Binding Inspector}" Visibility="{Binding HasRow, Converter={StaticResource BoolToVis}}">

                <!--  ================= Sticky header =================  -->
                <StackPanel DockPanel.Dock="Top">
                    <!--  Preview strip: position, next door, navigation, exit  -->
                    <Border
                        Padding="14,8,8,8"
                        Background="{DynamicResource Accent.Subtle}"
                        BorderBrush="{DynamicResource Surface.Stroke}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0"
                        DataContext="{Binding DataContext.Preview, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <CheckBox
                                    VerticalAlignment="Center"
                                    Content="Auto zoom"
                                    IsChecked="{Binding AutoZoom}"
                                    Style="{StaticResource Input.Check}"
                                    ToolTip="Zoom the Revit view to each door as the review moves on" />
                                <Button
                                    Margin="6,0,0,0"
                                    Command="{Binding ExitCommand}"
                                    Content="End review"
                                    Style="{StaticResource Button.Plain}"
                                    ToolTip="Clear the preview graphics and return to the list (Esc)" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Accent.Text}"
                                        Kind="EyeOutline" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Accent.Text}"
                                        Text="{Binding PositionText}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="21,1,0,0"
                                    Style="{StaticResource Type.Caption}"
                                    Text="{Binding NextHint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!--  Door identity  -->
                    <DockPanel Margin="16,14,10,0">
                        <StackPanel
                            VerticalAlignment="Top"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="{Binding ZoomText}"
                                Command="{Binding ZoomCommand}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="{Binding ZoomText}">
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Kind="MagnifyScan" />
                            </Button>
                            <!--  The other view (3D when plans are the default, and the other way round)  -->
                            <Button
                                AutomationProperties.Name="{Binding ZoomAlternativeText}"
                                Command="{Binding ZoomAlternativeCommand}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="{Binding ZoomAlternativeText}">
                                <materialDesign:PackIcon Width="17" Height="17">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="{x:Type materialDesign:PackIcon}">
                                            <Setter Property="Kind" Value="FloorPlan" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlternativeZoom3D}" Value="True">
                                                    <Setter Property="Kind" Value="CubeOutline" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                            <Button
                                x:Name="DoorMoreButton"
                                AutomationProperties.Name="More actions for this door"
                                Click="DoorMoreButton_Click"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="More actions for this door">
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Kind="DotsHorizontal" />
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="DoorMoreMenu">
                                        <MenuItem Command="{Binding ZoomAlternativeCommand}" Header="{Binding ZoomAlternativeText}" />
                                        <MenuItem Command="{Binding MarkReviewedCommand}" Header="Mark as reviewed">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="CheckDecagramOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding SelectComponentsCommand}" Header="Select components in Revit" />
                                        <MenuItem Command="{Binding SelectSourceCommand}" Header="Select source door in Revit" />
                                        <Separator Style="{StaticResource MenuSeparator}" />
                                        <MenuItem Command="{Binding DeleteComponentsCommand}" Header="Delete placed components…">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="DeleteOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource Type.Title}"
                                Text="{Binding Title}"
                                ToolTip="{Binding Title}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource Type.Secondary}"
                                Text="{Binding Subtitle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </DockPanel>

                    <!--  State line: status (icon + word), review state, rooms  -->
                    <WrapPanel Margin="16,10,16,0" Orientation="Horizontal">
                        <StackPanel Margin="0,0,14,4" Orientation="Horizontal">
                            <materialDesign:PackIcon Style="{StaticResource StatusIcon}" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{StaticResource StatusText}"
                                Text="{Binding StatusText}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,0,14,4"
                            Orientation="Horizontal"
                            Visibility="{Binding ReviewText, Converter={StaticResource NotEmptyToVis}}">
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Text.Tertiary}"
                                Kind="CheckDecagramOutline" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Text.Secondary}"
                                Text="{Binding ReviewText}" />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Margin="16,2,16,0" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Text.Tertiary}"
                            Kind="FloorPlan" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Text.Secondary}"
                            Text="{Binding RoomsText}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="Rooms on side A · side B" />
                    </StackPanel>

                    <!--  Outcome of this door in the current review (Placed / Skipped / Failed…)  -->
                    <Border
                        Margin="16,10,16,0"
                        Padding="10,6"
                        Background="{DynamicResource Status.Info.Subtle}"
                        CornerRadius="{StaticResource Radius.Control}"
                        DataContext="{Binding DataContext.Preview, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Visibility="{Binding OutcomeText, Converter={StaticResource NotEmptyToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Status.Info}"
                                Kind="InformationOutline" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding OutcomeText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  Issues stay in view while components scroll  -->
                    <Border
                        Margin="16,10,16,0"
                        Padding="10,8"
                        Style="{StaticResource InsetCard}"
                        Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer
                            x:Name="IssuesScroll"
                            MaxHeight="104"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl AutomationProperties.Name="Issues" ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <materialDesign:PackIcon Style="{StaticResource IssueIcon}" />
                                            <TextBlock
                                                FontSize="{StaticResource FontSize.Secondary}"
                                                Text="{Binding Message}"
                                                TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Rectangle
                        Height="1"
                        Margin="0,14,0,0"
                        Fill="{DynamicResource Separator}" />
                </StackPanel>

                <!--  ================= Sticky footer: door set decisions + preview confirmation =================  -->
                <!--  Set, direction, flip and hinge stay in one place right above Skip / Place, so a review is
                      decided without scrolling back up for every door.  -->
                <Border
                    Padding="14,10"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0"
                    DockPanel.Dock="Bottom">
                    <StackPanel>
                        <ComboBox
                            AutomationProperties.Name="Door set"
                            DisplayMemberPath="Text"
                            IsEnabled="{Binding IsEditable}"
                            ItemsSource="{Binding SetChoices}"
                            SelectedItem="{Binding SelectedSet}"
                            Style="{StaticResource Input.Combo}"
                            ToolTip="Door set for this door (changes update the preview immediately)" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource Type.Secondary}"
                            Text="Decided: this door needs no access control, so nothing is placed. Choose a door set to change it."
                            TextWrapping="Wrap"
                            Visibility="{Binding IsNoAccessControl, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Visibility="{Binding HasInstance, Converter={StaticResource BoolToVis}}">
                            <ComboBox
                                Margin="0,6,0,0"
                                AutomationProperties.Name="Access direction"
                                DisplayMemberPath="Text"
                                IsEnabled="{Binding IsEditable}"
                                ItemsSource="{Binding DirectionChoices}"
                                SelectedItem="{Binding SelectedDirection}"
                                Style="{StaticResource Input.Combo}"
                                ToolTip="Controlled access direction: from the unsecured side into the secured side" />
                            <UniformGrid Margin="0,6,0,0" Columns="2">
                                <Button
                                    Margin="0,0,3,0"
                                    Command="{Binding FlipCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    ToolTip="Flip: swap the secured and unsecured sides">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SwapHorizontal" Style="{StaticResource ButtonIconLabel}" />
                                        <TextBlock Text="Flip sides" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Margin="3,0,0,0"
                                    Command="{Binding SwapHingeCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    ToolTip="{Binding HingeText}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DoorOpen" Style="{StaticResource ButtonIconLabel}" />
                                        <TextBlock Text="Swap hinge" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>

                        <!--  Preview confirmation (only while reviewing)  -->
                        <DockPanel
                            Margin="0,10,0,0"
                            DataContext="{Binding DataContext.Preview, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Button
                                    AutomationProperties.Name="Previous door"
                                    Command="{Binding PreviousCommand}"
                                    Style="{StaticResource Button.Icon}"
                                    ToolTip="Previous door (Alt+Left)">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        Kind="ChevronLeft" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Next door"
                                    Command="{Binding NextCommand}"
                                    Style="{StaticResource Button.Icon}"
                                    ToolTip="Next door without placing (Alt+Right)">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        Kind="ChevronRight" />
                                </Button>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,8,0"
                                    Command="{Binding SkipCommand}"
                                    Content="{Binding SkipText}"
                                    Style="{StaticResource Button.Secondary}"
                                    ToolTip="Leave this door unchanged and continue" />
                                <Button
                                    x:Name="ConfirmButton"
                                    MinWidth="120"
                                    Command="{Binding ConfirmCommand}"
                                    Content="{Binding ConfirmText}"
                                    Style="{StaticResource Button.Primary}"
                                    ToolTip="Write this door's components to the model as previewed, then show the next door" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!--  ================= Scrolling content =================  -->
                <ScrollViewer
                    x:Name="Scroll"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ScrollContent" Margin="16,14,16,16">

                        <StackPanel Visibility="{Binding HasInstance, Converter={StaticResource BoolToVis}}">
                            <!--  Components (the set, direction and hinge are in the footer)  -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="{Binding OverridesText}" />
                                <TextBlock Style="{StaticResource SectionHeader}" Margin="0" Text="Components" />
                            </DockPanel>
                            <ItemsControl
                                AutomationProperties.Name="Components"
                                Focusable="False"
                                ItemsSource="{Binding Components}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <views:ComponentRow Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--  Add a component to this door only  -->
                            <DockPanel Margin="0,4,0,0">
                                <Button
                                    Margin="6,0,0,0"
                                    Command="{Binding AddComponentCommand}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Button.Secondary}"
                                    ToolTip="Add this component to this door only (the set type is unchanged)">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Kind="Plus" />
                                        <TextBlock Text="Add" />
                                    </StackPanel>
                                </Button>
                                <ComboBox
                                    AutomationProperties.Name="Component to add"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding AddChoices}"
                                    SelectedItem="{Binding SelectedAdd}"
                                    Style="{StaticResource Input.Combo}" />
                            </DockPanel>
                        </StackPanel>

                        <!--  Source door changed (always visible: it needs a decision)  -->
                        <Border
                            Margin="0,16,0,0"
                            Padding="12,10"
                            Background="{DynamicResource Status.Warning.Subtle}"
                            BorderBrush="{DynamicResource Status.Warning}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasSourceChange, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Top"
                                        Foreground="{DynamicResource Status.Warning}"
                                        Kind="SwapHorizontalCircleOutline" />
                                    <TextBlock
                                        Style="{StaticResource Type.Body}"
                                        Text="{Binding SourceChangeText, StringFormat=Source door changed: {0}}" />
                                </DockPanel>
                                <Button
                                    Margin="24,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding AcceptSourceCommand}"
                                    Content="Accept new door data"
                                    Style="{StaticResource Button.Secondary}"
                                    ToolTip="Store the changed door as the new reference; placed components move on the next Update placement" />
                            </StackPanel>
                        </Border>

                        <!--  Source (progressive disclosure)  -->
                        <ToggleButton
                            x:Name="SourceToggle"
                            Margin="-4,16,0,4"
                            Content="Source door details"
                            Style="{StaticResource Toggle.Disclosure}" />
                        <Grid Margin="18,2,0,0" Visibility="{Binding IsChecked, ElementName=SourceToggle, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource KeyText}" Text="Link" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource ValueText}"
                                Text="{Binding LinkText}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource KeyText}"
                                Text="Type" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource ValueText}"
                                Text="{Binding TypeText}" />
                            <TextBlock
                                Grid.Row="2"
                                Style="{StaticResource KeyText}"
                                Text="Level" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource ValueText}"
                                Text="{Binding LevelText}" />
                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource KeyText}"
                                Text="Size" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource ValueText}"
                                Text="{Binding SizeText}" />
                            <TextBlock
                                Grid.Row="4"
                                Style="{StaticResource KeyText}"
                                Text="Wall" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource ValueText}"
                                Text="{Binding WallText}" />
                            <TextBlock
                                Grid.Row="5"
                                Style="{StaticResource KeyText}"
                                Text="IFC GUID" />
                            <TextBox
                                Grid.Row="5"
                                Grid.Column="1"
                                AutomationProperties.Name="IFC GUID"
                                FontFamily="{StaticResource Font.Mono}"
                                Style="{StaticResource Input.ReadOnlyValue}"
                                Text="{Binding GuidText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="6"
                                Style="{StaticResource KeyText}"
                                Text="Geometry" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                Style="{StaticResource ValueText}"
                                Text="{Binding GeometryText}" />
                            <TextBlock
                                Grid.Row="7"
                                Style="{StaticResource KeyText}"
                                Text="Parameters" />
                            <TextBlock
                                Grid.Row="7"
                                Grid.Column="1"
                                Style="{StaticResource ValueText}"
                                Text="{Binding ParametersText}" />
                            <TextBlock
                                Grid.Row="8"
                                Grid.ColumnSpan="2"
                                Margin="0,6,0,0"
                                Foreground="{DynamicResource Status.Warning}"
                                Style="{StaticResource ValueText}"
                                Text="{Binding ReadWarningsText}"
                                Visibility="{Binding ReadWarningsText, Converter={StaticResource NotEmptyToVis}}" />
                        </Grid>

                        <!--  Notes  -->
                        <TextBlock
                            Margin="0,16,0,6"
                            Style="{StaticResource SectionHeader}"
                            Text="Notes"
                            Visibility="{Binding HasInstance, Converter={StaticResource BoolToVis}}" />
                        <TextBox
                            AutomationProperties.Name="Notes"
                            IsEnabled="{Binding IsEditable}"
                            Style="{StaticResource Input.MultiLine}"
                            Tag="Notes for this door (saved with the project)"
                            Text="{Binding Notes, UpdateSourceTrigger=LostFocus}"
                            Visibility="{Binding HasInstance, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
