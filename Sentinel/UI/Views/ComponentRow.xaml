<UserControl
    x:Class="Sentinel.UI.Views.ComponentRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="clr-namespace:Sentinel.UI"
    xmlns:views="clr-namespace:Sentinel.UI.Views"
    AutomationProperties.Name="{Binding Label}">
    <!--  One component of the reviewed door (DataContext: InspectorComponentViewModel). Summary first, details on demand.  -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SharedDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="Card" Padding="12,10">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Surface.Stroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Style.Triggers>
                    <!--  The row being edited is marked with the accent edge  -->
                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Opacity" Value="0.75" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <!--  Title line: state glyph, label, badges, edit  -->
            <DockPanel>
                <materialDesign:PackIcon Style="{StaticResource StateIcon}" ToolTip="{Binding StateText}" />
                <Button
                    Height="26"
                    Margin="6,-3,-4,0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{Binding Label, StringFormat=Edit {0} for this door}"
                    Command="{Binding EditCommand}"
                    DockPanel.Dock="Right"
                    Visibility="{Binding IsRemoved, Converter={StaticResource InverseBoolToVis}}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource Button.Plain}" TargetType="{x:Type Button}">
                            <Setter Property="Content" Value="Adjust" />
                            <Setter Property="ToolTip" Value="Adjust this component for this door only" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Content" Value="Cancel" />
                                    <Setter Property="ToolTip" Value="Close without applying the changes" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button
                    Height="26"
                    Margin="6,-3,-4,0"
                    VerticalAlignment="Top"
                    Command="{Binding RestoreCommand}"
                    Content="Restore"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Button.Plain}"
                    ToolTip="Put this component back on this door"
                    Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVis}}" />
                <WrapPanel>
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding Label}" />
                    <Border
                        Margin="0,0,4,0"
                        Style="{StaticResource Badge.Accent}"
                        ToolTip="Adjusted on this door – differs from the door set type">
                        <Border.Visibility>
                            <MultiBinding Converter="{x:Static views:ComponentRow.OverrideBadge}">
                                <Binding Path="IsOverridden" />
                                <Binding Path="IsAdded" />
                            </MultiBinding>
                        </Border.Visibility>
                        <TextBlock Text="Override" />
                    </Border>
                    <Border
                        Margin="0,0,4,0"
                        Style="{StaticResource Badge}"
                        ToolTip="{Binding FamilyText}"
                        Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="11"
                                Height="11"
                                Margin="0,0,3,0"
                                VerticalAlignment="Center"
                                Kind="PuzzleOutline" />
                            <TextBlock Text="Built in" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="0,0,4,0"
                        Style="{StaticResource Badge.Accent}"
                        ToolTip="Added on this door only"
                        Visibility="{Binding IsAdded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Added" />
                    </Border>
                    <Border
                        Margin="0,0,4,0"
                        Style="{StaticResource Badge}"
                        Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Removed" />
                    </Border>
                    <Border
                        Margin="0,0,4,0"
                        Style="{StaticResource Badge.Error}"
                        ToolTip="No Revit family is mapped – set it on the Components page"
                        Visibility="{Binding IsFamilyMissing, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="11"
                                Height="11"
                                Margin="0,0,3,0"
                                VerticalAlignment="Center"
                                Kind="AlertCircleOutline" />
                            <TextBlock Text="No family" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </DockPanel>

            <!--  Summary: where it goes. The state is spelled out only when it needs attention (the glyph shape
                 already distinguishes placed / planned); everything else is under Details.  -->
            <StackPanel Margin="26,3,0,0">
                <TextBlock Style="{StaticResource Type.Secondary}" Text="{Binding Summary}" />
                <DockPanel Margin="0,4,0,0">
                    <DockPanel.Style>
                        <Style TargetType="{x:Type DockPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StateKind}" Value="ok">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StateKind}" Value="planned">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <TextBlock
                        FontSize="{StaticResource FontSize.Secondary}"
                        FontWeight="SemiBold"
                        Text="{Binding StateText}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StateKind}" Value="error">
                                        <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKind}" Value="warn">
                                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKind}" Value="manual">
                                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <!--  Built in: which parameter of which component carries it  -->
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource Type.Caption}"
                    Text="{Binding FamilyText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}" />
                <!--  Several possible carriers on this door (e.g. two magnets): choose the one that holds it  -->
                <DockPanel Margin="0,6,0,0" Visibility="{Binding ShowsCarrierChoice, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Type.Secondary}"
                        Text="Built into" />
                    <ComboBox
                        AutomationProperties.Name="Built into"
                        DisplayMemberPath="Text"
                        ItemsSource="{Binding CarrierChoices}"
                        SelectedItem="{Binding CarrierChoice}"
                        Style="{StaticResource Input.Combo}"
                        ToolTip="Which component on this door carries it (e.g. the magnet on the latch side)" />
                </DockPanel>
                <!--  A missing family blocks placement, so it is never hidden  -->
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="{StaticResource FontSize.Secondary}"
                    Foreground="{DynamicResource Status.Error}"
                    Text="{Binding FamilyText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsFamilyMissing, Converter={StaticResource BoolToVis}}" />

                <!--  Placement issues for this component  -->
                <DockPanel Margin="0,6,0,0" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Margin="0,1,6,0"
                        VerticalAlignment="Top"
                        Foreground="{DynamicResource Status.Warning}"
                        Kind="AlertOutline" />
                    <TextBlock
                        FontSize="{StaticResource FontSize.Secondary}"
                        Foreground="{DynamicResource Status.Warning}"
                        Text="{Binding IssuesText}"
                        TextWrapping="Wrap" />
                </DockPanel>

                <!--  Moved in Revit: make that position the rule (this door or the whole set type), or just keep it  -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsMovedInModel, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource Type.Caption}"
                        Text="Moved in the model. Use that position from now on:"
                        TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button
                            Margin="0,0,6,6"
                            Command="{Binding UseForDoorCommand}"
                            Content="For this door"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Store the moved position as this door's placement (the set type is unchanged)" />
                        <Button
                            Margin="0,0,6,6"
                            Command="{Binding UseForSetCommand}"
                            Content="{Binding UseForSetText}"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Measure the moved position from the door and make it the rule of the door set type, for every door that uses it"
                            Visibility="{Binding CanUseForSet, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>
                    <Button
                        Margin="-8,0,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding AcceptManualCommand}"
                        Content="Only keep it where it is"
                        Style="{StaticResource Button.Plain}"
                        ToolTip="Leave the element where it was moved without changing any rule (Update placement will not move it back)"
                        Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!--  Details on demand: family, state, how the position is calculated  -->
                <ToggleButton
                    x:Name="WhyToggle"
                    Margin="-4,4,0,0"
                    Content="Details"
                    Style="{StaticResource Toggle.Disclosure}" />
                <StackPanel Margin="18,2,0,2" Visibility="{Binding IsChecked, ElementName=WhyToggle, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Type.Caption}" Text="{Binding FamilyText}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource Type.Caption}"
                        Text="{Binding StateText}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource Type.Secondary}"
                        Text="{Binding Explanation}"
                        Visibility="{Binding Explanation, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Type.Caption}"
                        Text="{Binding PlacementNotes}"
                        Visibility="{Binding PlacementNotes, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>
            </StackPanel>

            <!--  Inline editor (per-door override)  -->
            <StackPanel
                x:Name="EditorPanel"
                Margin="0,10,0,0"
                ui:Motion.Reveal="True"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <Rectangle
                    Height="1"
                    Margin="0,0,0,10"
                    Fill="{DynamicResource Separator}" />
                <TextBlock
                    Margin="0,0,0,4"
                    Style="{StaticResource Type.Label}"
                    Text="Component" />
                <ComboBox
                    Margin="0,0,0,10"
                    AutomationProperties.Name="Component"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding ComponentChoices}"
                    SelectedItem="{Binding EditComponent}"
                    Style="{StaticResource Input.Combo}" />
                <views:RuleEditorControl
                    DataContext="{Binding Editor}"
                    ShowDuplicateOption="False" />
                <DockPanel Margin="0,12,0,0">
                    <Button
                        Command="{Binding RemoveCommand}"
                        Content="Remove from door"
                        DockPanel.Dock="Left"
                        Foreground="{DynamicResource Status.Error}"
                        Style="{StaticResource Button.Plain}"
                        ToolTip="Remove this component from this door only (Update placement deletes a placed element)" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Margin="0,0,6,0"
                            Command="{Binding ResetCommand}"
                            Content="Use set default"
                            Style="{StaticResource Button.Plain}"
                            ToolTip="Discard this door's override and use the door set's rule" />
                        <Button
                            Command="{Binding ApplyCommand}"
                            Content="Apply"
                            Style="{StaticResource Button.Primary}"
                            ToolTip="Save the adjustment for this door (placed components move on Update placement)" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
