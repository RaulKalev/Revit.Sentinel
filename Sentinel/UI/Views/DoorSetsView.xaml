<UserControl
    x:Class="Sentinel.UI.Views.DoorSetsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="clr-namespace:Sentinel.UI"
    xmlns:views="clr-namespace:Sentinel.UI.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SharedDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style
                x:Key="FieldLabel"
                BasedOn="{StaticResource Type.Label}"
                TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  DataContext: DoorSetsViewModel  -->
    <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ===== Master list =====  -->
        <Border Style="{StaticResource Surface}">
            <DockPanel>
                <DockPanel Margin="14,12,8,6" DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            AutomationProperties.Name="New door set type"
                            Command="{Binding NewCommand}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="New door set type">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="Plus" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Duplicate door set type"
                            Command="{Binding DuplicateCommand}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Duplicate the selected set type">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="ContentCopy" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Delete door set type"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Delete the selected set type (only when no door uses it)">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="DeleteOutline" />
                        </Button>
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource Type.Heading}"
                        Text="Set types" />
                </DockPanel>
                <ListBox
                    Margin="6,0,6,6"
                    AutomationProperties.Name="Door set types"
                    ItemsSource="{Binding Definitions}"
                    SelectedItem="{Binding Selected}"
                    Style="{StaticResource MasterList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Code}" />
                                <TextBlock
                                    Margin="0,1,0,0"
                                    Style="{StaticResource Type.Secondary}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!--  ===== Editor =====  -->
        <Border Grid.Column="2" Style="{StaticResource Surface}">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <materialDesign:PackIcon
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Text.Tertiary}"
                        Kind="LayersTripleOutline" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource Type.Secondary}"
                        Text="Select a set type, or create one with +." />
                </StackPanel>

                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="20,16,20,20" IsEnabled="{Binding IsEditable}">
                        <!--  Identity  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Code" />
                                <TextBox
                                    AutomationProperties.Name="Code"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource Input.Text}"
                                    Text="{Binding Code, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                <TextBox
                                    AutomationProperties.Name="Name"
                                    Style="{StaticResource Input.Text}"
                                    Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Default access" />
                                <ComboBox
                                    AutomationProperties.Name="Default access direction"
                                    DisplayMemberPath="Text"
                                    ItemsSource="{Binding Directions}"
                                    SelectedItem="{Binding DefaultDirection}"
                                    Style="{StaticResource Input.Combo}"
                                    ToolTip="Access direction new assignments start with" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Margin="0,10,0,4"
                            Style="{StaticResource FieldLabel}"
                            Text="Description" />
                        <TextBox
                            AutomationProperties.Name="Description"
                            Style="{StaticResource Input.Text}"
                            Tag="What this set is for"
                            Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                        <DockPanel Margin="0,10,0,0">
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,8,0"
                                VerticalAlignment="Top"
                                Foreground="{DynamicResource Text.Tertiary}"
                                Kind="InformationOutline" />
                            <TextBlock Style="{StaticResource Type.Secondary}" Text="{Binding UsageText}" />
                        </DockPanel>

                        <!--  Components  -->
                        <DockPanel Margin="0,24,0,4">
                            <TextBlock Style="{StaticResource Type.Section}" Text="Components" />
                        </DockPanel>
                        <TextBlock
                            Margin="0,0,0,12"
                            Style="{StaticResource Type.Secondary}"
                            Text="Positions come only from these rules. Unsecured and secured sides follow each door's access direction." />

                        <ItemsControl
                            AutomationProperties.Name="Components of this set type"
                            Focusable="False"
                            ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12,8"
                                        Style="{StaticResource Card}">
                                        <StackPanel>
                                            <!--  Summary line (always visible)  -->
                                            <DockPanel>
                                                <StackPanel
                                                    VerticalAlignment="Top"
                                                    DockPanel.Dock="Right"
                                                    Orientation="Horizontal">
                                                    <!--  Row tools appear on hover or keyboard focus (less noise across many rows)  -->
                                                    <StackPanel.Style>
                                                        <Style TargetType="{x:Type StackPanel}">
                                                            <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button
                                                        AutomationProperties.Name="Move up"
                                                        Command="{Binding UpCommand}"
                                                        Style="{StaticResource Button.Icon}"
                                                        ToolTip="Move up">
                                                        <materialDesign:PackIcon Kind="ChevronUp" />
                                                    </Button>
                                                    <Button
                                                        AutomationProperties.Name="Move down"
                                                        Command="{Binding DownCommand}"
                                                        Style="{StaticResource Button.Icon}"
                                                        ToolTip="Move down">
                                                        <materialDesign:PackIcon Kind="ChevronDown" />
                                                    </Button>
                                                    <Button
                                                        AutomationProperties.Name="Remove component from this set type"
                                                        Command="{Binding RemoveCommand}"
                                                        Style="{StaticResource Button.Icon}"
                                                        ToolTip="Remove from this set type">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" />
                                                    </Button>
                                                </StackPanel>
                                                <ToggleButton
                                                    VerticalAlignment="Top"
                                                    AutomationProperties.Name="{Binding Label, StringFormat=Show placement of {0}}"
                                                    IsChecked="{Binding IsExpanded}"
                                                    Style="{StaticResource Toggle.Disclosure}">
                                                    <StackPanel>
                                                        <WrapPanel>
                                                            <TextBlock
                                                                Margin="0,0,8,0"
                                                                FontSize="{StaticResource FontSize.Body}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Text.Primary}"
                                                                Text="{Binding Label}" />
                                                            <TextBlock
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource Text.Secondary}"
                                                                Text="{Binding Component.Name}" />
                                                            <Border
                                                                Style="{StaticResource Badge.Error}"
                                                                ToolTip="{Binding FamilyText}"
                                                                Visibility="{Binding IsFamilyMissing, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon
                                                                        Width="11"
                                                                        Height="11"
                                                                        Margin="0,0,3,0"
                                                                        VerticalAlignment="Center"
                                                                        Kind="AlertCircleOutline" />
                                                                    <TextBlock Text="No family" />
                                                                </StackPanel>
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="{StaticResource FontSize.Secondary}"
                                                            Foreground="{DynamicResource Text.Secondary}"
                                                            Text="{Binding Summary}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DockPanel>

                                            <!--  Details (disclosure)  -->
                                            <StackPanel
                                                Margin="22,10,0,4"
                                                ui:Motion.FromY="-4"
                                                ui:Motion.Reveal="True"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Label" />
                                                        <TextBox
                                                            AutomationProperties.Name="Label"
                                                            Style="{StaticResource Input.Text}"
                                                            Text="{Binding Label, UpdateSourceTrigger=LostFocus}"
                                                            ToolTip="Label shown for this component (for example Reader)" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Component" />
                                                        <ComboBox
                                                            AutomationProperties.Name="Component"
                                                            DisplayMemberPath="Name"
                                                            ItemsSource="{Binding ComponentChoices}"
                                                            SelectedItem="{Binding Component}"
                                                            Style="{StaticResource Input.Combo}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock
                                                    Margin="0,0,0,10"
                                                    Text="{Binding FamilyText}"
                                                    TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style BasedOn="{StaticResource Type.Caption}" TargetType="{x:Type TextBlock}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFamilyMissing}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!--  Built in, and the set has several carriers (e.g. two magnets): which one holds it  -->
                                                <DockPanel Margin="0,0,0,10" Visibility="{Binding ShowsCarrierChoice, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource Type.Secondary}"
                                                        Text="Built into" />
                                                    <ComboBox
                                                        AutomationProperties.Name="Built into"
                                                        DisplayMemberPath="Text"
                                                        ItemsSource="{Binding CarrierChoices}"
                                                        SelectedItem="{Binding CarrierChoice}"
                                                        Style="{StaticResource Input.Combo}"
                                                        ToolTip="Which of this set's components carries it, e.g. the magnet on the latch side" />
                                                </DockPanel>
                                                <views:RuleEditorControl DataContext="{Binding Editor}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,4,0,0" HorizontalAlignment="Left">
                            <ComboBox
                                Width="220"
                                Margin="0,0,6,0"
                                AutomationProperties.Name="Component to add"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding ComponentChoices}"
                                SelectedItem="{Binding SelectedAdd}"
                                Style="{StaticResource Input.Combo}" />
                            <Button Command="{Binding AddRowCommand}" Style="{StaticResource Button.Secondary}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Kind="Plus" />
                                    <TextBlock Text="Add component" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
