<UserControl
    x:Class="Sentinel.UI.Views.DoorSetsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:views="clr-namespace:Sentinel.UI.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  DataContext: DoorSetsViewModel  -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Master list  -->
        <Border Style="{StaticResource Panel}">
            <DockPanel>
                <TextBlock
                    Margin="0,0,0,8"
                    DockPanel.Dock="Top"
                    Style="{StaticResource PageTitleText}"
                    Text="Door Set Types" />
                <WrapPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                    <Button
                        Command="{Binding NewCommand}"
                        Content="New"
                        Style="{StaticResource ActionButton}" />
                    <Button
                        Command="{Binding DuplicateCommand}"
                        Content="Duplicate"
                        Style="{StaticResource ActionButton}" />
                    <Button
                        Command="{Binding DeleteCommand}"
                        Content="Delete"
                        Style="{StaticResource ActionButton}" />
                </WrapPanel>
                <ListBox
                    ItemsSource="{Binding Definitions}"
                    SelectedItem="{Binding Selected}"
                    Style="{StaticResource MasterList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource BodyText}"
                                    Text="{Binding Code}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!--  Editor  -->
        <Border
            Grid.Column="2"
            Padding="0"
            Style="{StaticResource Panel}">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionText}"
                    Text="Select or create a door set type."
                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="14,12" IsEnabled="{Binding IsEditable}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="Code" />
                            <TextBox
                                Grid.Column="1"
                                Margin="0,2"
                                Style="{StaticResource InputTextBox}"
                                Text="{Binding Code, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock
                                Grid.Column="3"
                                Style="{StaticResource LabelText}"
                                Text="Name" />
                            <TextBox
                                Grid.Column="4"
                                Margin="0,2"
                                Style="{StaticResource InputTextBox}"
                                Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource LabelText}"
                                Text="Description" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="4"
                                Margin="0,2"
                                Style="{StaticResource InputTextBox}"
                                Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock
                                Grid.Row="2"
                                Style="{StaticResource LabelText}"
                                Text="Default access" />
                            <ComboBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="4"
                                MaxWidth="260"
                                Margin="0,2"
                                HorizontalAlignment="Left"
                                DisplayMemberPath="Text"
                                ItemsSource="{Binding Directions}"
                                SelectedItem="{Binding DefaultDirection}"
                                Style="{StaticResource InputComboBox}" />
                        </Grid>
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource CaptionText}"
                            Text="{Binding UsageText}" />

                        <TextBlock Style="{StaticResource SectionCaption}" Text="COMPONENTS AND PLACEMENT RULES" />
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource CaptionText}"
                            Text="Positions are driven only by these rules (no family-specific logic). Unsecured/secured sides follow each door's access direction." />

                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="10,8"
                                        Background="{DynamicResource TertiaryBackgroundBrush}"
                                        CornerRadius="5">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button
                                                        Command="{Binding UpCommand}"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="Move up">
                                                        <materialDesign:PackIcon Kind="ChevronUp" />
                                                    </Button>
                                                    <Button
                                                        Command="{Binding DownCommand}"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="Move down">
                                                        <materialDesign:PackIcon Kind="ChevronDown" />
                                                    </Button>
                                                    <Button
                                                        Command="{Binding RemoveCommand}"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="Remove from this set type">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBox
                                                    Width="150"
                                                    Margin="0,0,8,0"
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource InputTextBox}"
                                                    Text="{Binding Label, UpdateSourceTrigger=LostFocus}"
                                                    ToolTip="Label shown for this component (e.g. Reader)" />
                                                <ComboBox
                                                    Width="190"
                                                    Margin="0,0,8,0"
                                                    DisplayMemberPath="Name"
                                                    ItemsSource="{Binding ComponentChoices}"
                                                    SelectedItem="{Binding Component}"
                                                    Style="{StaticResource InputComboBox}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionText}"
                                                    Text="{Binding FamilyText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </DockPanel>
                                            <views:RuleEditorControl DataContext="{Binding Editor}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal">
                            <ComboBox
                                Width="220"
                                Margin="0,0,6,0"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding ComponentChoices}"
                                SelectedItem="{Binding SelectedAdd}"
                                Style="{StaticResource InputComboBox}" />
                            <Button Command="{Binding AddRowCommand}" Style="{StaticResource ActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Kind="Plus" />
                                    <TextBlock Text="Add component" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
