<UserControl
    x:Class="Sentinel.UI.Views.RuleEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="clr-namespace:Sentinel.UI"
    x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SharedDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style
                x:Key="FieldLabel"
                BasedOn="{StaticResource Type.Label}"
                TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        DataContext: PlacementRuleEditor. Labels sit above fields so the editor fits the narrow review panel.
        Common fields first; the rest behind "More placement options". Numbers validate as you type and the
        problem is written under the fields (not only as a red border or tooltip).
    -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Measured from" />
                <ComboBox
                    AutomationProperties.Name="Measured from"
                    DisplayMemberPath="Text"
                    ItemsSource="{Binding References}"
                    SelectedItem="{Binding Reference}"
                    Style="{StaticResource Input.Combo}"
                    ToolTip="Door reference the along-wall offset is measured from" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Side" />
                <ComboBox
                    AutomationProperties.Name="Side"
                    DisplayMemberPath="Text"
                    ItemsSource="{Binding Sides}"
                    SelectedItem="{Binding Side}"
                    Style="{StaticResource Input.Combo}"
                    ToolTip="Wall face the component is placed on" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,6">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Along wall (mm)" />
                <TextBox
                    AutomationProperties.Name="Along wall offset in millimetres"
                    Style="{StaticResource Input.Text}"
                    Text="{Binding AlongWall, UpdateSourceTrigger=PropertyChanged, Delay=250, ValidatesOnDataErrors=True}"
                    ToolTip="Distance along the wall from the reference; positive moves away from the door opening" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,0,0,6">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Height (mm)" />
                <TextBox
                    AutomationProperties.Name="Mounting height in millimetres"
                    Style="{StaticResource Input.Text}"
                    Tag="Component default"
                    Text="{Binding Height, UpdateSourceTrigger=PropertyChanged, Delay=250, ValidatesOnDataErrors=True}"
                    ToolTip="Mounting height; leave blank to use the component's default height" />
            </StackPanel>
        </Grid>

        <ToggleButton
            Margin="-4,2,0,2"
            Content="More placement options"
            IsChecked="{Binding ShowAdvanced}"
            Style="{StaticResource Toggle.Disclosure}" />

        <Grid
            Margin="0,6,0,0"
            ui:Motion.FromY="-4"
            ui:Motion.Reveal="True"
            Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Style="{StaticResource FieldLabel}" Text="From wall (mm)" />
                <TextBox
                    AutomationProperties.Name="Offset from the wall face in millimetres"
                    Style="{StaticResource Input.Text}"
                    Text="{Binding FromWall, UpdateSourceTrigger=PropertyChanged, Delay=250, ValidatesOnDataErrors=True}"
                    ToolTip="Distance off the wall face" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Height measured from" />
                <ComboBox
                    AutomationProperties.Name="Height measured from"
                    DisplayMemberPath="Text"
                    ItemsSource="{Binding HeightReferences}"
                    SelectedItem="{Binding HeightRef}"
                    Style="{StaticResource Input.Combo}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Orientation" />
                <ComboBox
                    AutomationProperties.Name="Orientation"
                    DisplayMemberPath="Text"
                    ItemsSource="{Binding Orientations}"
                    SelectedItem="{Binding Orientation}"
                    Style="{StaticResource Input.Combo}" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,0,0,10">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Rotation (°)" />
                <TextBox
                    AutomationProperties.Name="Extra rotation in degrees"
                    Style="{StaticResource Input.Text}"
                    Text="{Binding Rotation, UpdateSourceTrigger=PropertyChanged, Delay=250, ValidatesOnDataErrors=True}" />
            </StackPanel>
            <CheckBox
                Grid.Row="2"
                Grid.ColumnSpan="3"
                Margin="0,0,0,4"
                Content="Also place on the other side when access is controlled both ways"
                IsChecked="{Binding DuplicateBoth}"
                Style="{StaticResource Input.Check}"
                Visibility="{Binding ShowDuplicateOption, ElementName=Root, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!--  Validation, next to the fields  -->
        <Border
            Margin="0,8,0,0"
            Padding="10,6"
            Background="{DynamicResource Status.Error.Subtle}"
            CornerRadius="{StaticResource Radius.Control}"
            Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <materialDesign:PackIcon
                    Width="15"
                    Height="15"
                    Margin="0,1,8,0"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource Status.Error}"
                    Kind="AlertCircleOutline" />
                <TextBlock
                    AutomationProperties.LiveSetting="Assertive"
                    FontSize="{StaticResource FontSize.Secondary}"
                    Foreground="{DynamicResource Status.Error}"
                    Text="{Binding ValidationSummary}"
                    TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
