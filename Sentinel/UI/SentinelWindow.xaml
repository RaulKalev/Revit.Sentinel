<Window
    x:Class="Sentinel.UI.SentinelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Sentinel.UI"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:views="clr-namespace:Sentinel.UI.Views"
    Title="Sentinel"
    Width="1280"
    Height="780"
    MinWidth="980"
    MinHeight="560"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Theme (swapped at runtime by ThemeManager) + shared styles  -->
                <ResourceDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Background="Transparent"
        ClipToBounds="True"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove">

        <!--  Outer border (same chrome as the other RK Tools windows)  -->
        <Border
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="2"
            CornerRadius="10"
            Opacity="0.7"
            SnapsToDevicePixels="True">
            <Border.Effect>
                <BlurEffect KernelType="Gaussian" Radius="2" />
            </Border.Effect>
        </Border>

        <Border
            Margin="2"
            Background="{DynamicResource PrimaryBackgroundBrush}"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Height="0.2"
                    Margin="-2,0,-2,-0.1"
                    VerticalAlignment="Bottom"
                    Background="Gray" />
                <local:TitleBar
                    x:Name="TitleBarControl"
                    Title="{Binding WindowTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                    Margin="0,0,0,1"
                    Foreground="{DynamicResource ForegroundBrush}" />

                <!--  Save state + theme toggle (left of minimize / close)  -->
                <StackPanel
                    Margin="0,0,70,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding SaveState}" />
                    <ToggleButton
                        x:Name="ThemeToggleButton"
                        Width="28"
                        Height="16"
                        Click="ToggleTheme_Click"
                        ToolTip="Toggle theme">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Grid Background="Transparent">
                                    <materialDesign:PackIcon
                                        x:Name="Icon"
                                        Width="30"
                                        Height="30"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource IconBrush}"
                                        Kind="ToggleSwitchOffOutline" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Icon" Property="Kind" Value="ToggleSwitchOutline" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>

                <!--  Banner (read-only / load warnings)  -->
                <Border
                    Grid.Row="1"
                    Margin="10,8,10,0"
                    Padding="10,6"
                    Background="{DynamicResource BannerBackgroundBrush}"
                    CornerRadius="5"
                    Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource WarningBrush}"
                            Kind="AlertOutline" />
                        <TextBlock
                            FontSize="11.5"
                            Style="{StaticResource BodyText}"
                            Text="{Binding Banner}" />
                    </DockPanel>
                </Border>

                <!--  Navigation rail + pages  -->
                <Grid Grid.Row="2" Margin="0,8,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="4,0,6,0">
                        <RadioButton
                            GroupName="Nav"
                            IsChecked="{Binding IsDoorsPage}"
                            Style="{StaticResource NavRailButton}"
                            ToolTip="Doors: discover doors, assign sets, preview and place">
                            <StackPanel>
                                <materialDesign:PackIcon
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Kind="DoorClosedLock" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Text="Doors" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            GroupName="Nav"
                            IsChecked="{Binding IsDoorSetsPage}"
                            Style="{StaticResource NavRailButton}"
                            ToolTip="Door set types and their component placement rules">
                            <StackPanel>
                                <materialDesign:PackIcon
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Kind="LayersTripleOutline" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Text="Door Sets" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            GroupName="Nav"
                            IsChecked="{Binding IsRulesPage}"
                            Style="{StaticResource NavRailButton}"
                            ToolTip="Rule-based door set suggestions">
                            <StackPanel>
                                <materialDesign:PackIcon
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Kind="SourceBranch" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Text="Rules" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            GroupName="Nav"
                            IsChecked="{Binding IsComponentsPage}"
                            Style="{StaticResource NavRailButton}"
                            ToolTip="Component library and Revit family mapping">
                            <StackPanel>
                                <materialDesign:PackIcon
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Kind="CardAccountDetailsOutline" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Text="Components" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            GroupName="Nav"
                            IsChecked="{Binding IsSettingsPage}"
                            Style="{StaticResource NavRailButton}"
                            ToolTip="Settings, library import/export, data information">
                            <StackPanel>
                                <materialDesign:PackIcon
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Kind="CogOutline" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Text="Settings" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <views:DoorsView DataContext="{Binding Doors}" Visibility="{Binding DataContext.IsDoorsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        <views:DoorSetsView DataContext="{Binding DoorSets}" Visibility="{Binding DataContext.IsDoorSetsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        <views:RulesView DataContext="{Binding Rules}" Visibility="{Binding DataContext.IsRulesPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        <views:ComponentsView DataContext="{Binding Components}" Visibility="{Binding DataContext.IsComponentsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        <views:SettingsView DataContext="{Binding Settings}" Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>

                <!--  Status bar  -->
                <DockPanel
                    Grid.Row="3"
                    Height="30"
                    Margin="14,4,14,6">
                    <StackPanel
                        Margin="0,0,10,0"
                        DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <ProgressBar
                            Width="70"
                            Height="4"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}"
                            IsIndeterminate="True" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionText}"
                            Text="{Binding BusyText}" />
                    </StackPanel>
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding Doors.Summary}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Text="{Binding StatusMessage}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding StatusMessage}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Grid>
        </Border>

        <!--  Resize edges  -->
        <Border
            Width="5"
            HorizontalAlignment="Left"
            Background="Transparent"
            Cursor="SizeWE"
            MouseLeftButtonDown="LeftEdge_MouseLeftButtonDown" />
        <Border
            Width="5"
            HorizontalAlignment="Right"
            Background="Transparent"
            Cursor="SizeWE"
            MouseLeftButtonDown="RightEdge_MouseLeftButtonDown" />
        <Border
            Height="5"
            VerticalAlignment="Bottom"
            Background="Transparent"
            Cursor="SizeNS"
            MouseLeftButtonDown="BottomEdge_MouseLeftButtonDown" />
        <Border
            Width="10"
            Height="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="Transparent"
            Cursor="SizeNESW"
            MouseLeftButtonDown="BottomLeftCorner_MouseLeftButtonDown" />
        <Border
            Width="10"
            Height="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            Cursor="SizeNWSE"
            MouseLeftButtonDown="BottomRightCorner_MouseLeftButtonDown" />
    </Grid>
</Window>
