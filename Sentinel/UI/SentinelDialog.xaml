<Window
    x:Class="Sentinel.UI.SentinelDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="520"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Sentinel;component/UI/Themes/SentinelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        Margin="8"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1.5"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="14"
                Opacity="0.45"
                ShadowDepth="2" />
        </Border.Effect>
        <StackPanel Margin="18,14,18,16">
            <DockPanel MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <materialDesign:PackIcon
                    x:Name="HeaderIcon"
                    Width="20"
                    Height="20"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AccentBrush}"
                    Kind="ShieldLockOutline" />
                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource PageTitleText}"
                    Text="Sentinel" />
            </DockPanel>
            <TextBlock
                x:Name="MessageText"
                Margin="0,12,0,0"
                Style="{StaticResource BodyText}" />
            <TextBox
                x:Name="DetailsBox"
                MaxHeight="260"
                Margin="0,10,0,0"
                FontFamily="Consolas"
                FontSize="11"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                Style="{StaticResource MultiLineTextBox}"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <TextBox.Template>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border
                            Padding="6,4"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
            <CheckBox
                x:Name="OptionBox"
                Margin="0,10,0,0"
                Style="{StaticResource InputCheckBox}"
                Visibility="Collapsed" />
            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="NoButton"
                    Click="No_Click"
                    IsCancel="True"
                    Style="{StaticResource ActionButton}" />
                <Button
                    x:Name="YesButton"
                    Margin="0"
                    Click="Yes_Click"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
