<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Colors for Light Theme (RK Tools palette)  -->
    <Color x:Key="PrimaryBackgroundColor">White</Color>
    <Color x:Key="SecondaryBackgroundColor">#FFE9E9E9</Color>
    <Color x:Key="TertiaryBackgroundColor">#FFDCDCDC</Color>
    <Color x:Key="BorderBrushColor">#FFC4C4C4</Color>
    <Color x:Key="ForegroundColor">Black</Color>
    <Color x:Key="HighlightColor">#FFD6D6D6</Color>
    <Color x:Key="IconColor">Black</Color>
    <Color x:Key="IconForegroundColor">#FF5A5A5A</Color>
    <Color x:Key="IconHoverColor">#FF808080</Color>
    <Color x:Key="IconPressedColor">#bebebe</Color>
    <Color x:Key="TextHighlightColor">#0078D7</Color>
    <Color x:Key="SelectedRowColor">#FFCDEAFF</Color>

    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="{StaticResource TertiaryBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderBrushColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="IconBrush" Color="{StaticResource IconColor}" />
    <SolidColorBrush x:Key="IconForegroundBrush" Color="{StaticResource IconForegroundColor}" />
    <SolidColorBrush x:Key="IconHoverBrush" Color="{StaticResource IconHoverColor}" />
    <SolidColorBrush x:Key="IconPressedBrush" Color="{StaticResource IconPressedColor}" />
    <SolidColorBrush x:Key="TextHighlightBrush" Color="{StaticResource TextHighlightColor}" />
    <SolidColorBrush x:Key="SelectionHoverBrush" Color="{StaticResource IconHoverColor}" />
    <SolidColorBrush x:Key="SelectedRowBrush" Color="{StaticResource SelectedRowColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="OkBrush" Color="#11906B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B38600" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C23B3B" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0063B1" />
    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#FFFFF4D6" />

</ResourceDictionary>
