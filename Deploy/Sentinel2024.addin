<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
  Sentinel for Revit 2024 (.NET Framework 4.8).
  Copy to %ProgramData%\Autodesk\Revit\Addins\2024\ (all users) or %AppData%\Autodesk\Revit\Addins\2024\ (current user)
  and point <Assembly> to the net48 build of Sentinel.dll (single merged DLL):
    Sentinel\bin\Release\net48\Sentinel.dll
-->
<RevitAddIns>
  <AddIn Type="Application">
    <Name>Sentinel</Name>
    <Assembly>C:\Path\To\Sentinel\net48\Sentinel.dll</Assembly>
    <FullClassName>Sentinel.App</FullClassName>
    <AddInId>8E2B7C41-5A93-4F0D-B6E1-3C9D2A7F5E18</AddInId>
    <VendorId>RaulKalev</VendorId>
    <VendorDescription>Raul Kalev (RK Tools)</VendorDescription>
  </AddIn>
</RevitAddIns>
